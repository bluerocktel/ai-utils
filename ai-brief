#!/bin/bash
# ai-brief: decompose a high-level brief into structured task files.
#
# Usage:
#   ai-brief [--runner NAME] [brief.md]  Decompose a brief in a detached tmux
#                                        session. With no file argument, takes
#                                        the oldest brief in $TASKS_DIR/briefs/.
#   ai-brief --run FILE [--runner NAME]  Internal mode used by tmux. Do not call
#                                        directly.
#
# Pipeline:
#   briefs/ → ai-brief → backlog-for-review/ → (HUMAN REVIEW) → inbox/
#
# THE REVIEW GATE IS THE POINT. Emitted tasks land in backlog-for-review/ and
# nowhere else; a human moves them to inbox/ once read. ai-brief has no write
# path into inbox/ at all: the only destination it ever writes task files to is
# $BACKLOG_REVIEW_DIR, and the extraction step strips every path component off
# the model-proposed filename, so no output from the agent can redirect a write
# out of that directory.
#
# This file is PROVIDER-NEUTRAL by contract. It must never name a vendor, a
# vendor CLI, a vendor model id, a vendor CLI flag or a vendor JSON field.
# Everything that differs between runners goes through the six functions in
# providers/CONTRACT.md, loaded by load_provider.

set -euo pipefail

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib.sh"

usage() {
    echo "Usage:"
    echo "  ai-brief [--runner NAME] [brief.md]  Decompose a brief (oldest in briefs/ if omitted)"
    echo "  ai-brief --run FILE [--runner NAME]  Internal mode used by tmux; do not call directly"
    echo ""
    echo "Output goes to backlog-for-review/ for human review. Never to inbox/."
}

# ── Argument parsing ───────────────────────────────────────────────────────
# --runner may appear before or after --run / the brief file, so the launcher
# and the tmux child accept the same flag order.
MODE=launch
RUNNER_FLAG=""
BRIEF_ARG=""

while [ $# -gt 0 ]; do
    case "$1" in
        --run)
            MODE=run
            BRIEF_ARG="${2:?--run requires a brief file}"
            shift 2
            ;;
        --runner)
            RUNNER_FLAG="${2:?--runner requires a runner name}"
            shift 2
            ;;
        --runner=*)
            RUNNER_FLAG="${1#*=}"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --*)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
        *)
            if [ -n "$BRIEF_ARG" ]; then
                echo "Unexpected extra argument: $1" >&2
                exit 1
            fi
            BRIEF_ARG="$1"
            shift
            ;;
    esac
done

# ── Config ─────────────────────────────────────────────────────────────────
BRIEF_TIMEOUT_MIN=45
AUTH_COOLDOWN_MIN=30

load_config
BRIEF_TIMEOUT_MIN=${brief_timeout_min:-$BRIEF_TIMEOUT_MIN}
AUTH_COOLDOWN_MIN=${auth_cooldown_min:-$AUTH_COOLDOWN_MIN}

# ── Runner resolution ──────────────────────────────────────────────────────
# Two runners are in play and they are deliberately separate:
#
#   DECOMPOSITION runner  the provider that does the decomposition NOW.
#                         --runner flag, else default_runner.
#   STAMP runner          the provider that will EXECUTE the emitted tasks,
#                         written into each file as ## Runner.
#                         The brief's own ## Runner section wins, else the
#                         --runner flag, else default_runner.
#
# The brief wins for the stamp because a brief decomposed by one runner is
# often meant for another, and because an implicit runner makes the eventual
# routing invisible to the human reviewing the batch.

# Normalise a runner name the same way lib.sh does.
norm_runner() {
    printf '%s' "${1:-}" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]'
}

# Raw ## Runner section of a file, with NO fallback to default_runner.
# runner_from_task cannot be used here: it resolves an absent section to the
# default, and this caller has to tell "absent" from "explicitly set" apart.
runner_section_of() {
    local file="${1:-}"
    [ -r "$file" ] || return 0
    awk '/^## Runner/{found=1; next} found && /^[^#]/{print $1; exit} found && /^##/{exit}' "$file" \
        | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]'
}

# The runner this invocation acts as: --runner, else default_runner.
resolve_invocation_runner() {
    local r
    r=$(norm_runner "${RUNNER_FLAG:-${default_runner:-}}")
    [ -n "$r" ] || return 1
    printf '%s\n' "$r"
}

# The runner stamped on the emitted tasks: brief section, else flag, else default.
resolve_stamp_runner() {
    local brief="${1:-}" r
    r=$(runner_section_of "$brief")
    [ -n "$r" ] || r="${RUNNER_FLAG:-}"
    [ -n "$r" ] || r="${default_runner:-}"
    r=$(norm_runner "$r")
    [ -n "$r" ] || return 1
    printf '%s\n' "$r"
}

# Force a file's ## Runner section to RUNNER.
#
# Any ## Runner the model wrote itself is dropped first: the resolution order
# above is the authority, and a model-invented runner would route the task to a
# provider nobody chose. The section is inserted directly after the ## Project
# block so a human scanning the review queue sees the routing next to the
# project, without having to scroll.
stamp_runner_section() {
    local file="$1" runner="$2" stripped inserted
    [ -f "$file" ] || return 1
    stripped=$(mktemp)
    inserted=$(mktemp)

    awk '
        /^## Runner([[:space:]]|$)/ { skip = 1; next }
        skip && /^## / { skip = 0 }
        skip { next }
        { print }
    ' "$file" > "$stripped"

    if grep -qE '^## Project([[:space:]]|$)' "$stripped"; then
        awk -v runner="$runner" '
            !done_it && inproj && /^## / {
                print "## Runner"
                print runner
                print ""
                done_it = 1
            }
            { print }
            /^## Project([[:space:]]|$)/ { inproj = 1 }
            END {
                if (!done_it) {
                    print ""
                    print "## Runner"
                    print runner
                }
            }
        ' "$stripped" > "$inserted"
    else
        # No ## Project to anchor to: put the routing at the very top, where it
        # is still the first thing a reviewer reads.
        {
            echo "## Runner"
            printf '%s\n' "$runner"
            echo ""
            cat "$stripped"
        } > "$inserted"
    fi

    mv "$inserted" "$file"
    rm -f "$stripped"
}

# ── Acceptance-criteria lint ────────────────────────────────────────────────
# Appends a ## Criteria Warnings section to an emitted task file when a
# criterion matches one of the shapes that has actually produced an
# unsatisfiable check here. It WARNS and never rejects: the batch lands in a
# human review queue, and a linter confident enough to delete a task would
# need to be right far more often than a heuristic can be.
#
# Five shapes, each mapped to a real failure:
#   1. an asserted integer nobody re-derived  (a brief said 24, the file had 23,
#      the criterion demanded 28)
#   2. a `grep -c` whose pattern also appears in a fenced block under ## Tasks,
#      so obeying the instruction inflates the count the criterion asserts
#   3. an assertion that ONE named file holds more than one match, when the
#      second match usually belongs to a different file
#   4. a git working-tree state assertion  (june-minutes-pdf demanded
#      `git diff -- <paths> | ... | wc -l` return 0, against a tree carrying a
#      months-old uncommitted fix the build itself depended on)
#
#   5. a multi-word grep against raw extracted document text with no line
#      join  (agm-report-regenerate-pdf greped a regenerated PDF for
#      `Lions Christmas Party`; pdftotext hard-wraps, the renderer broke the
#      line after `Christmas`, and the count was 0 for every correct run)
#
# Reads the file, writes only the appended section. Always returns 0: a lint
# hiccup must never cost a decomposed batch.
lint_task_criteria() {
    local file="$1" crit tasks warns
    [ -f "$file" ] || return 0

    crit=$(awk '/^## Acceptance Criteria/{f=1;next} f&&/^## /{exit} f{print}' "$file")
    [ -n "${crit//[[:space:]]/}" ] || return 0

    # Only the FENCED text under ## Tasks: prose naturally repeats the names a
    # criterion greps for, and warning on that would fire on every task.
    tasks=$(awk '/^## Tasks/{f=1;next} f&&/^## /{exit} f&&/^[[:space:]]*```/{inb=!inb;next} f&&inb{print}' "$file")

    warns=$(
        printf '%s\n' "$crit" | while IFS= read -r line; do
            case "$line" in
                [-*]*) ;;
                *) continue ;;
            esac
            # (1) an asserted integer literal. "report"/"record" mark the
            # observe-don't-assert form the rules ask for, so skip those.
            if printf '%s' "$line" | grep -qiE "(returns|equals|is exactly|exactly|==)[[:space:]]+.?\`?[0-9]+" \
               && ! printf '%s' "$line" | grep -qiE '\b(report|record|observ)'; then
                printf '  - asserted integer: re-derive it with a command, or assert the invariant and report the number instead.\n    %s\n' "$line"
            fi
            # (3) more than one match demanded from a single named file.
            if printf '%s' "$line" | grep -qiE 'matches? (at least )?(twice|[2-9]|two|three)' ; then
                printf '  - multi-match in one file: confirm that file owns every match, else name each file and assert one each.\n    %s\n' "$line"
            fi
            # (4) a git working-tree state assertion. The permitted shape
            # asserts changed-line CONTENT (`... | grep -c <pattern>` returns
            # 0); a bare `wc -l`, or a demand that git report nothing, is tree
            # state, which the task does not own and no ## Criteria Baseline
            # can license, because every task shares one tree with tasks from
            # other batches that run while it runs.
            if printf '%s' "$line" | grep -qE '\bgit[[:space:]]+(diff|status|ls-files)\b' \
               && ! printf '%s' "$line" | grep -qiE '\b(report|record|observ)'; then
                if printf '%s' "$line" | grep -qE '\|[[:space:]]*wc[[:space:]]+-l' \
                   || printf '%s' "$line" | grep -qiE 'is clean|lists nothing|no output|returns nothing|is empty|shows no change|unchanged|byte-identical'; then
                    printf '  - git working-tree state: forbidden in every form, and a baseline cannot license one (the tree is shared with tasks that run concurrently). Assert changed-line CONTENT with a pattern instead of counting lines, or have the run sha256sum the paths first and sha256sum -c them last.\n    %s\n' "$line"
                fi
            fi
            # (5) a multi-word phrase greped against raw extracted document
            # text. pdftotext and its family hard-wrap what they emit, so a
            # phrase that renders correctly in the document is split across two
            # output lines and the grep returns 0 for every correct run. A
            # single-token pattern cannot wrap, and a pipeline that joins the
            # lines first is the fix, so neither of those warns.
            if printf '%s' "$line" | grep -qE '\b(pdftotext|pdftoppm|pdfinfo|catdoc|antiword)\b' \
               && printf '%s' "$line" | grep -qE '\|[[:space:]]*grep\b' \
               && ! printf '%s' "$line" | grep -qE '\btr[^|]*\\n|\btr[[:space:]]+-d|\bpaste[[:space:]]+-sd|\bgrep[^|]*[[:space:]]-[A-Za-z]*z|\bawk[^|]*RS=|\bsed[^|]*[[:space:]]-[A-Za-z]*z'; then
                if printf '%s' "$line" | sed 's/.*|[[:space:]]*grep/grep/' \
                   | grep -qE "'[^']*[[:space:]][^']*'|\"[^\"]*[[:space:]][^\"]*\""; then
                    printf '  - phrase grep on extracted text: pdftotext hard-wraps its output, so a phrase that renders correctly in the document is still split across two lines and the grep fails for every correct run. Join the extraction first, for example by piping through tr with a newline argument, or grep a single word that cannot wrap.\n    %s\n' "$line"
                fi
            fi
            # (2) a counting grep whose pattern is dictated by ## Tasks itself.
            if [ -n "$tasks" ] && printf '%s' "$line" | grep -q 'grep -c'; then
                printf '%s' "$line" | grep -oE "grep -c[^\`]*'[^']+'" | grep -oE "'[^']+'" | tr -d "'" \
                | while IFS= read -r pat; do
                    [ -n "$pat" ] || continue
                    if printf '%s' "$tasks" | grep -qF -- "$pat"; then
                        printf '  - pattern %s is also prescribed literally under ## Tasks, so following the instruction changes this count.\n    %s\n' "$pat" "$line"
                    fi
                done
            fi
        done
    )

    [ -n "${warns//[[:space:]]/}" ] || return 0
    {
        echo ""
        echo "## Criteria Warnings"
        echo ""
        echo "Written by ai-brief's lint, for the human reviewing this batch. Each line"
        echo "is a criterion shape that has produced an unsatisfiable check before. None"
        echo "of them is automatically wrong; check each before promoting this task."
        echo ""
        printf '%s\n' "$warns"
    } >> "$file"
    return 0
}

# Inspect draft text as data, never execute model-generated checks. Return notes
# for policy violations that warrant regeneration, not a proof of satisfiability.
brief_criteria_issues() {
    local draft="$1" name criterion
    awk '
        function flush() {
            if (item != "") { print name "\t" item; count++; item="" }
        }
        /^===TASK_FILE_BEGIN: / {
            if (active) print name "\tINVALID_TASK_DELIMITERS"
            begins++
            name=$0; sub(/^===TASK_FILE_BEGIN: /,"",name); sub(/===$/,"",name)
            active=1; criteria=0; count=0; item=""; next
        }
        /^===TASK_FILE_END===/ {
            if (!active) print "draft\tINVALID_TASK_DELIMITERS"
            flush()
            if (active && count==0) print name "\tMISSING_ACCEPTANCE_CRITERIA"
            active=0; criteria=0; next
        }
        !active {next}
        /^## Acceptance Criteria[[:space:]]*$/ {criteria=1; next}
        /^## / {flush(); criteria=0; next}
        criteria && /^[[:space:]]*([-*+] |[0-9]+[.)] )/ {flush(); item=$0; next}
        criteria && item!="" && /[^[:space:]]/ {item=item " " $0}
        END {
            if (active || !begins) print "draft\tINVALID_TASK_DELIMITERS"
        }
    ' "$draft" | while IFS=$'\t' read -r name criterion; do
        if [ "$criterion" = INVALID_TASK_DELIMITERS ]; then
            printf '%s: missing or malformed task delimiters.\n' "$name"
        fi
        if [ "$criterion" = MISSING_ACCEPTANCE_CRITERIA ]; then
            printf '%s: missing nonempty acceptance checklist.\n' "$name"
        fi
        # Include git -C/--git-dir variants and multiline checklist items.
        # Merely saying "report" must not hide a simultaneous clean-tree demand.
        if printf '%s' "$criterion" | grep -qE '\bgit[[:space:]][^`|;]*(diff|status|ls-files)\b' \
           && { { { ! printf '%s' "$criterion" | grep -qE '\|[[:space:]]*grep\b' \
                     || printf '%s' "$criterion" | grep -qE '\bgit[[:space:]][^`|;]*status\b'; } \
                  && printf '%s' "$criterion" | grep -qiE 'is clean|must be clean|lists nothing|no output|returns nothing|is empty|shows no change|unchanged|byte-identical|diff[^`]*--(quiet|exit-code)[^`]*`[^`]*(exits? (with )?`?0|succeeds)'; } \
                || { printf '%s' "$criterion" | grep -qE '\|[[:space:]]*wc[[:space:]]+-l' \
                     && printf '%s' "$criterion" | grep -qiE 'returns?|equals?|must|==|exactly'; }; }; then
            printf '%s: git working-tree assertion; use execution-time preservation evidence or task-owned content checks.\n  %s\n' "$name" "$criterion"
        fi
        if printf '%s' "$criterion" | grep -qE '`[^`]*[[:space:]]\.\.\.([[:space:]`]|$)'; then
            printf '%s: abbreviated command; provide the complete command and explicit target path.\n  %s\n' "$name" "$criterion"
        fi
        if printf '%s' "$criterion" | grep -qE '\b(pdftotext|catdoc|antiword)\b.*\|[[:space:]]*grep\b' \
           && ! printf '%s' "$criterion" | grep -qE '\btr[^|]*\\n|\bpaste[[:space:]]+-sd|\bgrep[^|]*[[:space:]]-[A-Za-z]*z|\bawk[^|]*RS=|\bsed[^|]*[[:space:]]-[A-Za-z]*z' \
           && printf '%s' "$criterion" | sed 's/.*|[[:space:]]*grep/grep/' \
                | grep -qE "'[^']*[[:space:]][^']*'|\"[^\"]*[[:space:]][^\"]*\""; then
            printf '%s: phrase search on wrapped extracted text; normalize whitespace before matching.\n  %s\n' "$name" "$criterion"
        fi
    done
}

# ── Internal execution mode ────────────────────────────────────────────────
if [ "$MODE" = run ]; then
    BRIEF_FILE="$BRIEF_ARG"
    BRIEF_NAME=$(basename "$BRIEF_FILE" .md)
    TIMESTAMP=$(date '+%Y-%m-%d_%H-%M')
    TODAY=$(date '+%Y-%m-%d')
    RAW_FILE="$RUN_DIR/${TIMESTAMP}_${BRIEF_NAME}.raw"
    BRIEF_ARCHIVE="$BRIEFS_DONE_DIR/${BRIEF_NAME}.md"
    ERR_TMP=""

    if [ ! -f "$BRIEF_FILE" ]; then
        echo "Brief file not found: $BRIEF_FILE" >&2
        exit 1
    fi

    if ! DECOMP_RUNNER=$(resolve_invocation_runner); then
        echo "No runner: pass --runner NAME or set default_runner in $SCRIPT_DIR/config" >&2
        exit 1
    fi
    if ! STAMP_RUNNER=$(resolve_stamp_runner "$BRIEF_FILE"); then
        echo "No runner to stamp: brief has no ## Runner and config sets no default_runner." >&2
        exit 1
    fi

    # Validate the stamp target BEFORE the expensive agent call. A stamp naming
    # a provider that does not exist would produce a whole batch of tasks that
    # no ai-task invocation can ever claim, and the failure would only surface
    # much later, after the human review pass.
    if ! ( load_provider "$STAMP_RUNNER" >/dev/null ); then
        echo "Refusing to decompose: ## Runner '$STAMP_RUNNER' has no provider." >&2
        exit 1
    fi
    # A half-defined or unknown adapter is fatal, deliberately: falling back to
    # some default would run the decomposition on a provider nobody chose.
    load_provider "$DECOMP_RUNNER" || exit 1

    COOLDOWN_FILE=$(cooldown_path "$DECOMP_RUNNER")

    # inbox/ is deliberately absent from this list. ai-brief has no reason to
    # create it, let alone write to it: the human review gate is the whole
    # point of the backlog-for-review/ hop.
    mkdir -p "$RUN_DIR" "$BRIEFS_DIR" "$BRIEFS_DONE_DIR" "$BACKLOG_REVIEW_DIR"

    # Put the brief back in the queue so the next run retries it. Every failure
    # path calls this, so it must not be able to fail: the launcher normally
    # moves the brief into run/ first, but a direct `--run` on a file still in
    # briefs/ makes source and destination the same path. `mv` errors there, and
    # under `set -e` that aborts before the notify and the "brief restored"
    # message, leaving the operator with a bare mv complaint and no idea the
    # brief is still queued.
    restore_brief() {
        local dest="$BRIEFS_DIR/${BRIEF_NAME}.md"
        mkdir -p "$BRIEFS_DIR"
        [ -e "$BRIEF_FILE" ] || return 0
        if [ "$(realpath "$BRIEF_FILE")" = "$(realpath -m "$dest")" ]; then
            return 0
        fi
        mv "$BRIEF_FILE" "$dest"
    }

    write_raw() {
        {
            echo "# ai-brief debug capture: $BRIEF_NAME"
            echo "# $(date '+%Y-%m-%d %H:%M') (decomposed by: $DECOMP_RUNNER, tasks stamped: $STAMP_RUNNER)"
            echo ""
            if [ -n "${1:-}" ]; then
                printf '%s\n' "$1"
            fi
            if [ -n "$ERR_TMP" ] && [ -s "$ERR_TMP" ]; then
                echo ""
                echo "_stderr:_"
                echo '```'
                cat "$ERR_TMP"
                echo '```'
            fi
        } > "$RAW_FILE"
    }

    PROJECT=$(project_from_task "$BRIEF_FILE")

    # ── Prompt ──────────────────────────────────────────────────────────────
    # Vendor-neutral by contract. ai_preamble_extra is deliberately NOT appended
    # here (ai-task does append it): the provider extras describe the shape of a
    # RESULT REPORT (## Tools Used and friends), which would directly contradict
    # this prompt's "output only the delimited task blocks" contract and break
    # extraction.
    PREAMBLE="BRIEF DECOMPOSITION MODE: You are decomposing a high-level brief into multiple well-scoped autonomous task files ready for execution by ai-task.

Your job, in order:

1. Read the brief and find the ## Project field. Read $PROJECTS_DIR/{alias}.md to learn the working directory, stack, and conventions.

2. Explore the codebase with tools: grep and glob to find the specific files, line numbers, class names, and patterns the work touches. Exclude vendor/, node_modules/, storage/framework/ from all searches. Embed exact paths in every task you produce. Do not invent file paths. During exploration, run only safe read-only baseline checks. Never run a future acceptance command that writes data, changes files, invokes a migration, or requires a deliverable that does not exist yet. Record such checks as deferred until execution, with the prerequisite and expected behavior; never invent an observed result.

3. Decide how many task files to create. Split when:
   - Changes are in different areas and could be reviewed or rolled back independently
   - One step produces output that a later step consumes (sequencing risk)
   Keep together when changes are tightly coupled or touch only 2-3 files.

4. Determine the execution order. Prefer independent tasks. Only serialize when task B cannot start until files or data that task A creates actually exist. Files that already exist on disk are not a reason to add ## Depends-on.

5. Write each task and output it using EXACTLY this delimiter format, nothing else in your output:

===TASK_FILE_BEGIN: ${TODAY}_SLUG.md===
## Project
{alias}

## Brief
${BRIEF_ARCHIVE}

## Context
{Why this change is needed. What currently exists. Exact file paths and line numbers you found in step 2. If this task consumes output from a prior task, state exactly what file or data it expects and where. If any decision requires understanding the full scope of the work, refer the executing agent to the ## Brief file.}

## Tasks
{Numbered concrete instructions. Exact strings to find/replace when relevant.}

## Criteria Baseline
{For each safe baseline check: exact command, observed output and exit status. For future artifacts or predecessor outputs: DEFERRED, prerequisite, and the check to run once available. Baselines are historical observations, never execution preconditions. Write NONE when no baseline is relevant. Never fabricate a measurement.}

## Acceptance Criteria
{Bulleted checklist of verifiable pass/fail items. Prefer shell-command-checkable criteria. Scope every check to what THIS task creates or changes, following the ACCEPTANCE CRITERIA rules below. Give complete commands with explicit paths, expected output and exit status; no ellipsis placeholders. Add a negative check only when this task actually removes or replaces something, scoped to the exact artifact or behavior it owns.}
===TASK_FILE_END===

Replace SLUG with a short lowercase description specific to that task (not the whole brief).
Use ${TODAY} as the date prefix for all filenames.

TARGET RUNNER: every task in this batch will be executed by the runner named '${STAMP_RUNNER}'. Write for that runner: assume only the tools and conventions it actually has. Do NOT write a ## Runner section yourself. ai-brief stamps ## Runner ${STAMP_RUNNER} on every emitted file, and a hand-written one is discarded.

ACCEPTANCE CRITERIA — only write checks that a correct implementation can actually pass:
- DISTINGUISH CURRENT EVIDENCE FROM FUTURE REQUIREMENTS. A check may correctly fail before implementation. Do not weaken it merely because its baseline fails. Explain how the task will make it pass. If the target is a new artifact or a predecessor output, defer measuring it until it exists. Never guess counts or claim to have measured future outputs.
- OUTPUT IS NOT EXIT STATUS. For grep, no matches normally means exit status 1 even when grep -c prints 0. State which is being checked, handle expected absence explicitly, and distinguish errors from no matches. For exact counts, count semantic entities rather than matching lines when one line can contain several entities.
- REVIEW THE COMPLETE BATCH BEFORE EMITTING IT. For every criterion, identify the owning task step, exact target, prerequisites, and a plausible passing result after those steps. Check that predecessor changes cannot invalidate it. Resolve contradictions between Tasks, Context, and Acceptance Criteria without removing requested behavior or expanding scope. Do not substitute documentation of a failure for fixing requested behavior.
- PRESERVATION CHECKS use measurements taken at execution start and end, with the exact command and both results recorded in the final report. Never compare against HEAD or a decomposition-time hash. Limit coverage to the protected paths and explain exclusions. If another writer changes them, report the interference without reverting its work or pretending a match.
- SCOPE EVERY CHECK TO WHAT THIS TASK CREATES OR CHANGES. Assert against a provenance marker the task itself writes: a comment or tag column, a filename pattern, a config key, a specific commit. Never assert on the state of a whole table, a whole directory, or a whole codebase that existed before this task.
- NEVER write an absolute total that is a baseline you measured during exploration plus a delta you predicted. 'TOTAL == 439 + 143' breaks two ways: the baseline moves if anything else touches the data before the task runs, and the 143 is a guess that exploration cannot fully verify — a case-insensitive collation folding two labels into one row, a value that turns out to already exist, a dedupe or upsert rule. Write '142 rows carrying marker M exist' instead: the task creates those rows, so the task can guarantee them.
- NEVER assert a global invariant the task does not own. 'No duplicate X anywhere' fails on pre-existing duplicates the task did not create, and the only way to make it pass is to mutate data the task was never asked to touch. Scope it: 'no duplicate X among the rows this task created'.
