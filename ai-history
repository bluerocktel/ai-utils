#!/bin/bash
# ai-history: what was done on a project, and where it stands now.
#
# For a human coming back to a project after a while. Everything here is
# rebuilt from the task tree on each run (done/, the queues, suggestions/ and
# git), so the facts are never out of date.
#
# The one exception is WHERE THINGS STAND: a paragraph an agent writes from
# those facts, cached in $TASKS_DIR/.history/<project>.md and rewritten only
# when the project's tasks have changed. That cache is the only thing this
# script writes, and no task prompt ever reads it.
#
# Usage:
#   ai-history                    Every project, with its last activity
#   ai-history PROJECT            WHERE THINGS STAND, then NOW, RECENT, BRIEFS
#   ai-history PROJECT --facts    Facts only: no agent call, nothing written
#   ai-history PROJECT --refresh  Rewrite the paragraph even if nothing changed
#   ai-history PROJECT -n N       Show the last N finished tasks (default 15)
set -euo pipefail

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib.sh"
load_config

usage() {
    sed -n '/^# Usage:/,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'
}

PROJECT_ARG=""
RECENT_N=15
FACTS_ONLY=0
REFRESH=0
while [ $# -gt 0 ]; do
    case "$1" in
        --facts) FACTS_ONLY=1; shift ;;
        --refresh) REFRESH=1; shift ;;
        -n) RECENT_N="${2:-}"; shift 2 || { usage >&2; exit 2; } ;;
        -h|--help) usage; exit 0 ;;
        -*) echo "ai-history: unknown option '$1'" >&2; usage >&2; exit 2 ;;
        *) PROJECT_ARG="$1"; shift ;;
    esac
done
case "$RECENT_N" in ''|*[!0-9]*|0) echo "ai-history: -n needs a positive number" >&2; exit 2 ;; esac

if [ -n "${NO_COLOR:-}" ] || [ ! -t 1 ]; then
    BOLD="" RED="" GREEN="" YELLOW="" CYAN="" DIM="" RESET=""
else
    BOLD=$(tput bold 2>/dev/null || echo "")
    RED=$(tput setaf 1 2>/dev/null || echo "")
    GREEN=$(tput setaf 2 2>/dev/null || echo "")
    YELLOW=$(tput setaf 3 2>/dev/null || echo "")
    CYAN=$(tput setaf 6 2>/dev/null || echo "")
    DIM=$(tput dim 2>/dev/null || tput setaf 8 2>/dev/null || echo "")
    RESET=$(tput sgr0 2>/dev/null || echo "")
fi

_section() { printf '\n%s%s%s\n' "${BOLD}${CYAN}" "$1" "$RESET"; }

# 2026-10-30_11-19_2026-10-30_some-task.task.md -> some-task
_display() {
    basename "$1" | sed -E 's/\.task\.md$|\.md$//; s/^[0-9]{4}-[0-9]{2}-[0-9]{2}_([0-9]{2}-[0-9]{2}_)?//; s/^[0-9]{4}-[0-9]{2}-[0-9]{2}_//'
}

# 2026-10-30_11-19_... -> "10-30 11:19"; a name without the time keeps the day.
_when() {
    basename "$1" | sed -nE 's/^[0-9]{4}-([0-9]{2}-[0-9]{2})_([0-9]{2})-([0-9]{2})_.*/\1 \2:\3/p; t; s/^[0-9]{4}-([0-9]{2}-[0-9]{2})_.*/\1      /p'
}

# One line saying what a finished task did: the subject of its report's
# ## Suggested Commit Message (written to be exactly that), else the first
# sentence of its ## Summary, flattened and shortened.
_first_sentence() {
    local report="$1" line
    [ -r "$report" ] || return 0
    line=$(awk '/^## Suggested Commit Message/{f=1; next}
                f && /^## /{exit}
                f && /^```/{next}
                f && NF {print; exit}' "$report")
    [ -n "$line" ] || line=$(awk '/^## Summary/{f=1; next} f && /^## /{exit} f && NF {print; exit}' "$report")
    line=$(printf '%s' "$line" | sed -E 's/^[[:space:]]*([-*]|[0-9]+\.)[[:space:]]+//; s/\*\*//g; s/`//g')
    line=$(printf '%s' "$line" | sed -E 's/([.!?])[[:space:]].*/\1/')
    [ "${#line}" -gt 110 ] && line="${line:0:107}..."
    printf '%s' "$line"
}

# One tab-separated line per task file that names a project:
#   <file> \t <raw ## Project token>
# A single awk pass over every file, because done/ holds thousands of them and
# a process per file would take seconds. Same rule as project_from_task: the
# first non-heading line under ## Project, first token, stopping at the next
# heading.
_index() {
    local d
    for d in "$@"; do
        [ -d "$d" ] || continue
        find "$d" -maxdepth 1 -type f -name '20*.md' -print0
    done | xargs -0 -r awk '
        FNR == 1 { found = 0 }
        /^## Project/ { found = 1; next }
        found && /^[^#]/ { print FILENAME "\t" $1; nextfile }
        found && /^##/ { nextfile }
    '
}

# Raw ## Project token -> canonical project, as canonical_project in lib.sh
# decides it: sanitise, an existing project file wins, else a declared alias
# matched case-insensitively, else the value unchanged. canonical_project
# rescans every project file's aliases for each token that is not a file
# name, and done/ is full of those, so the alias table is built ONCE here and
# the answer cached. tests/test_history.sh checks the two agree.
# Sets CANON_OUT rather than printing: a $(...) caller would run in a
# subshell and the cache would never fill.
declare -A CANON=() ALIAS_OF=()
if [ -d "$PROJECTS_DIR" ]; then
    for pf in "$PROJECTS_DIR"/*.md; do
        [ -f "$pf" ] || continue
        stem=$(basename "$pf" .md)
        while IFS= read -r alias; do
            [ -n "$alias" ] || continue
            [ -n "${ALIAS_OF[$alias]+x}" ] || ALIAS_OF[$alias]="$stem"
        done < <(section_from_task Aliases "$pf" \
                    | sed -E 's/^[[:space:]]*-[[:space:]]*//; s/`//g; s/^[[:space:]]+//; s/[[:space:]]+$//' \
                    | tr '[:upper:]' '[:lower:]')
    done
fi
CANON_OUT=""
_canon() {
    local raw="$1" value
    if [ -z "${CANON[$raw]+x}" ]; then
        value="${raw##*/}"
        value="${value//[^A-Za-z0-9._-]/}"
        if [ -z "$value" ]; then
            CANON[$raw]="_unnamed"
        elif [ -f "$PROJECTS_DIR/${value}.md" ]; then
            CANON[$raw]="$value"
        else
            CANON[$raw]="${ALIAS_OF[${value,,}]:-$value}"
        fi
    fi
    CANON_OUT="${CANON[$raw]}"
}

# Every task file of the tree, as three parallel arrays (canonical project,
# where it is, path): reading tab-joined rows back with a here-string costs a
# temporary file per row, and there are well over a thousand rows.
# Finished tasks are the done/*.task.md files only: the reports beside them
# carry no ## Project, and a failed attempt leaves a report but no .task.md.
ROW_P=() ROW_W=() ROW_F=()
_add_row() { ROW_P+=("$CANON_OUT"); ROW_W+=("$1"); ROW_F+=("$2"); }
while IFS=$'\t' read -r file raw; do
    [ -n "$raw" ] || continue
    case "$file" in
        "$DONE_DIR"/*.task.md) where=done ;;
        "$DONE_DIR"/*) continue ;;
        "$INBOX"/*) where=inbox ;;
        "$RUN_DIR"/*) where=run ;;
        "$REVIEW_DIR"/*) where=review ;;
        "$BACKLOG_REVIEW_DIR"/*) where=backlog ;;
        "$SUGGEST_DIR"/*) where=suggestion ;;
        *) continue ;;
    esac
    _canon "$raw"
    _add_row "$where" "$file"
done < <(_index "$DONE_DIR" "$INBOX" "$RUN_DIR" "$REVIEW_DIR" "$BACKLOG_REVIEW_DIR")
# Suggestions are not date-prefixed, so they are indexed on their own.
while IFS=$'\t' read -r file raw; do
    [ -n "$raw" ] || continue
    _canon "$raw"
    _add_row suggestion "$file"
done < <([ -d "$SUGGEST_DIR" ] && find "$SUGGEST_DIR" -maxdepth 1 -type f -name '*.md' -print0 \
            | xargs -0 -r awk '
                FNR == 1 { found = 0 }
                /^## Project/ { found = 1; next }
                found && /^[^#]/ { print FILENAME "\t" $1; nextfile }
                found && /^##/ { nextfile }
            ')

# ── No project: one line per project file ───────────────────────
if [ -z "$PROJECT_ARG" ]; then
    [ -d "$PROJECTS_DIR" ] || exit 0
    declare -A last_done=() n_open=()
    for i in "${!ROW_P[@]}"; do
        p="${ROW_P[$i]}" where="${ROW_W[$i]}" file="${ROW_F[$i]}"
        case "$where" in
            done)
                b="${file##*/}"
                [[ "$b" > "${last_done[$p]:-}" ]] && last_done[$p]="$b" ;;
            inbox|run|review) n_open[$p]=$(( ${n_open[$p]:-0} + 1 )) ;;
        esac
    done
    lines=()
    for pf in "$PROJECTS_DIR"/*.md; do
        [ -f "$pf" ] || continue
        p=$(basename "$pf" .md)
        last="${last_done[$p]:-}"
        lines+=("${last:-0}"$'\t'"$p")
    done
    [ "${#lines[@]}" -gt 0 ] || exit 0
    printf '%s%-24s  %-12s  %s%s\n' "$DIM" "PROJECT" "LAST DONE" "OPEN" "$RESET"
    while IFS=$'\t' read -r last p; do
        if [ "$last" = 0 ]; then when="never"; else when=$(_when "$last"); fi
        open=${n_open[$p]:-0}
        [ "$open" -gt 0 ] && open="${YELLOW}${open}${RESET}"
        printf '%-24s  %-12s  %b\n' "$p" "$when" "$open"
    done < <(printf '%s\n' "${lines[@]}" | sort -r)
    exit 0
fi

# ── One project ─────────────────────────────────────────────────
PROJECT=$(canonical_project "$PROJECT_ARG")
PF="$PROJECTS_DIR/${PROJECT}.md"
if [ ! -f "$PF" ]; then
    echo "ai-history: no project file for '$PROJECT_ARG' in $PROJECTS_DIR" >&2
    exit 1
fi

done_files=() queued=() review=() backlog=() suggestions=()
for i in "${!ROW_P[@]}"; do
    [ "${ROW_P[$i]}" = "$PROJECT" ] || continue
    where="${ROW_W[$i]}" file="${ROW_F[$i]}"
    case "$where" in
        done) done_files+=("$file") ;;
        inbox|run) queued+=("$file") ;;
        review) review+=("$file") ;;
        backlog) backlog+=("$file") ;;
        suggestion) suggestions+=("$file") ;;
    esac
done

# Header: name, working directory, isolation.
wd=$(project_working_dir "$PROJECT" 2>/dev/null || true)
iso=$(project_isolation "$PROJECT" 2>/dev/null || echo "?")
base=$(project_field "$PROJECT" 'Base Branch')
info="${wd/#"$HOME"/\~}"
if [ "$iso" = worktree ]; then
    info+="   worktree isolation${base:+, base $base}"
fi
printf '%s%s%s   %s%s%s\n' "$BOLD" "$PROJECT" "$RESET" "$DIM" "$info" "$RESET"

# ── Briefs of this project ──
# A brief's tasks share its ## Brief path. Counted across every queue so a
# brief reads "2/3 done" while its last task is still running.
# One awk pass reads every ## Brief (inline or next-line form, as
# field_from_task does); a process per task file took seconds here.
# ai-brief stamps a path; older hand-written tasks carry free text there,
# which is not a brief this view can group by, so only a first token ending
# in .md counts.
declare -A b_total=() b_done=() b_first=() b_path=()
while IFS=$'\t' read -r f br; do
    br="${br//\`/}"
    br="${br%%[[:space:]]*}"
    case "$br" in *.md) ;; *) continue ;; esac
    br_path="${br/#\~\//$HOME/}"
    br="${br##*/}"; br="${br%.md}"
    b_path[$br]="$br_path"
    b_total[$br]=$(( ${b_total[$br]:-0} + 1 ))
    case "$f" in "$DONE_DIR"/*) b_done[$br]=$(( ${b_done[$br]:-0} + 1 )) ;; esac
    b="${f##*/}"
    if [ -z "${b_first[$br]:-}" ] || [[ "$b" < "${b_first[$br]}" ]]; then b_first[$br]="$b"; fi
done < <(printf '%s\0' "${done_files[@]}" "${queued[@]}" "${review[@]}" "${backlog[@]}" \
            | grep -zv '^$' | xargs -0 -r awk '
                FNR == 1 { want = 0 }
                tolower($0) ~ /^##[[:space:]]+brief[:[:space:]]*$/ { want = 1; next }
                tolower($0) ~ /^##[[:space:]]+brief[:[:space:]]/ {
                    v = $0; sub(/^##[[:space:]]+[Bb][Rr][Ii][Ee][Ff][:[:space:]]*/, "", v)
                    print FILENAME "\t" v; nextfile
                }
                want && /^#/ { nextfile }
                want && NF { print FILENAME "\t" $0; nextfile }
            ')

# The base a brief's branch started from: the brief's own ## Base Branch,
# else the project's, as task_base_branch resolves it for ai-task. Without
# this a brief started from a customer branch reads "ready to merge into" the
# project's base, which is the wrong target.
brief_base() {
    local key="$1" b=""
    [ -n "${b_path[$key]:-}" ] && b=$(field_from_task 'Base Branch' "${b_path[$key]}" | tr -d '`')
    printf '%s' "${b:-${base:-HEAD}}"
}

# NOW, RECENT and BRIEFS. A function because it is rendered twice: in colour
# for the reader, and plain as the input of the WHERE THINGS STAND paragraph.
print_facts() {
    # ── NOW ──
    _section "NOW"
    printf '  queued %d · in review %d · awaiting your review %d · suggestions %d\n' \
        "${#queued[@]}" "${#review[@]}" "${#backlog[@]}" "${#suggestions[@]}"
    for f in "${review[@]}"; do
        printf '  %s✗%s %s  %s(failed, in review/)%s\n' "$RED" "$RESET" "$(_display "$f")" "$DIM" "$RESET"
    done
    for f in "${queued[@]}"; do
        case "$f" in "$RUN_DIR"/*) state="running" ;; *) state="queued" ;; esac
        printf '  %s⏳%s %s  %s(%s)%s\n' "$DIM" "$RESET" "$(_display "$f")" "$DIM" "$state" "$RESET"
    done
    for f in "${backlog[@]}"; do
        printf '  %s●%s %s  %s(waiting for your review in backlog-for-review/)%s\n' "$YELLOW" "$RESET" "$(_display "$f")" "$DIM" "$RESET"
    done
    # Suggestions pile up (they wait for a human to promote or delete them), so
    # only the newest few are named.
    SUGGEST_SHOWN=5
    if [ "${#suggestions[@]}" -gt 0 ]; then
        while IFS= read -r f; do
            title=$(grep -m1 '^# ' "$f" 2>/dev/null | sed 's/^# //' || true)
            printf '  %s›%s %s  %s(suggestion)%s\n' "$DIM" "$RESET" "${title:-$(basename "$f" .md)}" "$DIM" "$RESET"
        done < <(ls -t "${suggestions[@]}" | head -n "$SUGGEST_SHOWN")
        if [ "${#suggestions[@]}" -gt "$SUGGEST_SHOWN" ]; then
            printf '  %s  … and %d more in %s%s\n' "$DIM" $(( ${#suggestions[@]} - SUGGEST_SHOWN )) \
                "${SUGGEST_DIR/#"$HOME"/\~}/" "$RESET"
        fi
    fi

    # Brief branches, with the same action rule dtask uses (worktree_action).
    if [ "$iso" = worktree ] && [ -n "$wd" ]; then
        top=$(git -C "$wd" rev-parse --show-toplevel 2>/dev/null || true)
        if [ -n "$top" ]; then
            declare -A live=() rev=()
            for f in "${queued[@]}"; do k=$(worktree_key "$f" 2>/dev/null) && live[$k]=$(( ${live[$k]:-0} + 1 )); done
            for f in "${review[@]}"; do k=$(worktree_key "$f" 2>/dev/null) && rev[$k]=$(( ${rev[$k]:-0} + 1 )); done
            while IFS= read -r key; do
                [ -n "$key" ] || continue
                kbase=$(brief_base "$key")
                action=$(GIT_OPTIONAL_LOCKS=0 worktree_action "$top" "$key" "$kbase" \
                    "${live[$key]:-0}" "${rev[$key]:-0}")
                case "$action" in
                    fix) text="${RED}✗ a task failed review${RESET}" ;;
                    commit) text="${YELLOW}⚠ uncommitted changes, no task left${RESET}" ;;
                    merge) text="${YELLOW}⇢ ready to merge into $kbase: git merge ai/$key${RESET}" ;;
                    prune) text="${DIM}· finished, worktree removed by the next sweep${RESET}" ;;
                    wait) text="${DIM}⏳ tasks still to run${RESET}" ;;
                    *) continue ;;
                esac
                printf '  branch %s  %b\n' "ai/$key" "$text"
            done < <(GIT_OPTIONAL_LOCKS=0 git -C "$top" for-each-ref --format='%(refname:short)' \
                        refs/heads/ai/ 2>/dev/null | sed 's|^ai/||')
        fi
    fi

    # ── RECENT ──
    _section "RECENT   (last $RECENT_N finished)"
    if [ "${#done_files[@]}" -eq 0 ]; then
        printf '  %snothing finished yet%s\n' "$DIM" "$RESET"
    else
        while IFS= read -r f; do
            report="${f%.task.md}.md"
            printf '  %s  %s✓%s %-44s  %s\n' "$(_when "$f")" "$GREEN" "$RESET" \
                "$(_display "$f")" "$(_first_sentence "$report")"
        done < <(printf '%s\n' "${done_files[@]}" | sort -r | head -n "$RECENT_N")
    fi

    # ── BRIEFS (scanned before print_facts) ──
    if [ "${#b_total[@]}" -gt 0 ]; then
        _section "BRIEFS"
        for br in "${!b_total[@]}"; do
            printf '%s\t%s\n' "${b_first[$br]}" "$br"
        done | sort -r | head -n 10 | while IFS=$'\t' read -r first br; do
            n=${b_done[$br]:-0} t=${b_total[$br]}
            if [ "$n" -eq "$t" ]; then mark="${GREEN}${n}/${t} done${RESET}"; else mark="${YELLOW}${n}/${t} done${RESET}"; fi
            name="${br#"$PROJECT"-}"
            name="${name%-brief}"
            printf '  %s  %-48s  %b\n' "$(_when "$first" | cut -c1-5)" "$name" "$mark"
        done
    fi
}

# ── WHERE THINGS STAND ──────────────────────────────────────────
# One paragraph written by an agent from the facts above plus the summaries of
# the latest reports, for a reader who has forgotten the project. It is cached
# in $HISTORY_DIR/<project>.md with a fingerprint of the project's task files
# and branch states, and rewritten only when that fingerprint changes, so
# opening an unchanged project costs nothing.
#
# The cache is read by this script and nothing else: no task prompt includes
# it, by design (a paragraph that can be stale must not become an agent's
# fact). A call that fails, times out, or hits an auth failure leaves the
# previous paragraph in place, shown as stale; it never touches a cooldown
# marker or a task file.
HISTORY_DIR="$TASKS_DIR/.history"
HISTORY_RUNNER="${history_runner:-${default_runner:-}}"
HISTORY_MODEL="${history_model:-}"
HISTORY_TIMEOUT_MIN=5
HISTORY_REPORTS=8
AUTH_COOLDOWN_MIN="${auth_cooldown_min:-30}"

# Plain-text input of the prompt: the facts, then each recent report's
# ## Summary (capped, so one long report cannot crowd out the rest).
history_input() {
    local f report slug
    printf '%s\n' "$FACTS_PLAIN"
    printf '\n=== LATEST REPORT SUMMARIES (newest first) ===\n'
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        report="${f%.task.md}.md"
        printf '\n--- %s (%s) ---\n' "$(_display "$f")" "$(_when "$f")"
        awk '/^## Summary/{s=1; next} s && /^## /{exit} s' "$report" 2>/dev/null | head -c 2500
    done < <(printf '%s\n' "${done_files[@]}" | sort -r | head -n "$HISTORY_REPORTS")
    for f in "${review[@]}"; do
        slug=$(task_slug_from_name "$f")
        report=$(ls "$DONE_DIR"/*_"$slug".md 2>/dev/null | sort | tail -n 1 || true)
        [ -n "$report" ] || continue
        printf '\n--- %s (FAILED, in review/) ---\n' "$slug"
        awk '/^## Summary/{s=1; next} s && /^## /{exit} s' "$report" | head -c 2500
    done
}

# Changes whenever a task of the project is added, moves between queues, or a
# brief branch changes state; suggestions are left out, they arrive constantly
# and do not change where the project stands.
history_fingerprint() {
    { printf '%s\n' "${done_files[@]}" "${queued[@]}" "${review[@]}" "${backlog[@]}" | sort
      printf '%s\n' "$FACTS_PLAIN" | grep '^  branch ' || true
    } | sha256sum | cut -d' ' -f1
}

cooldown_active() {
    local marker
    marker=$(cooldown_path "$1") || return 1
    [ -f "$marker" ] || return 1
    find "$marker" -mmin -"$AUTH_COOLDOWN_MIN" 2>/dev/null | grep -q .
}

# Prints the paragraph on stdout, or nothing with the reason on stderr.
history_generate() {
    local prompt json err rc text workdir model_id
    if [ -z "$HISTORY_RUNNER" ]; then
        echo "no history_runner or default_runner in config" >&2; return 1
    fi
    if cooldown_active "$HISTORY_RUNNER"; then
        echo "runner '$HISTORY_RUNNER' is in auth cooldown" >&2; return 1
    fi
    ( load_provider "$HISTORY_RUNNER" ) >/dev/null 2>&1 || {
        echo "runner '$HISTORY_RUNNER' has no usable provider" >&2; return 1; }
    load_provider "$HISTORY_RUNNER"
    model_id=$(ai_model_alias "$HISTORY_MODEL")

    prompt="You are writing a short status note for a person who comes back to the project '$PROJECT' after some time away and has forgotten where it stands. Below are the facts of the task pipeline for this project and the summaries of its latest finished tasks.

Write ONE paragraph of at most 6 sentences and 120 words, in plain prose: no heading, no list, no markdown, no '—' character. Keep only what matters most: the person can read the full facts below your paragraph. Say, in this order: what was done most recently and why it mattered; what is in progress or queued; what is waiting on the person (a review, a merge, a decision, a command to run), naming the task or branch; and any open follow-up the summaries mention. Use task and brief names exactly as given. Use ONLY the information below: do not run commands, do not read files, do not guess. If nothing is in progress or waiting, say so plainly.

$(history_input)"

    workdir=$(mktemp -d); json=$(mktemp); err=$(mktemp)
    # stdout and stderr to two SEPARATE files, never 2>&1 (gotcha 1). The
    # working directory is empty on purpose: there is nothing to read there.
    set +e
    ai_run "$prompt" "$model_id" "$workdir" "$((HISTORY_TIMEOUT_MIN * 60))" "$json" "$err"
    rc=$?
    set -e
    if ai_is_auth_failure "$json" || ai_is_auth_failure "$err"; then
        rm -rf "$workdir" "$json" "$err"
        echo "auth failure on runner '$HISTORY_RUNNER'" >&2; return 1
    fi
    text=$(ai_json_text "$json" 2>/dev/null || true)
    rm -rf "$workdir" "$json" "$err"
    if [ "$rc" -eq 124 ]; then
        echo "timed out after ${HISTORY_TIMEOUT_MIN}m" >&2; return 1
    fi
    text=$(printf '%s' "$text" | sed -E '/^[[:space:]]*$/d' | tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')
    if [ -z "$text" ]; then
        echo "empty answer (exit $rc)" >&2; return 1
    fi
    printf '%s\n' "$text"
}

# The cache file: a small header, a blank line, the paragraph.
# A missing cache is the normal first run, not an error.
cache_field() { [ -f "$2" ] || return 0; sed -n "s/^$1: //p; /^\$/q" "$2" | head -n 1; }
cache_text() { [ -f "$1" ] || return 0; sed '1,/^$/d' "$1"; }

show_where_things_stand() {
    local cache="$HISTORY_DIR/${PROJECT}.md" fp old_fp text why="" note tmp errf
    fp=$(history_fingerprint)
    old_fp=$(cache_field fingerprint "$cache")
    if [ "$REFRESH" -eq 1 ] || [ "$fp" != "$old_fp" ]; then
        [ -t 2 ] && printf '%swriting the summary with %s...%s\n' "$DIM" "$HISTORY_RUNNER" "$RESET" >&2
        errf=$(mktemp)
        if text=$(history_generate 2>"$errf"); then
            mkdir -p "$HISTORY_DIR"
            tmp=$(mktemp "$HISTORY_DIR/.${PROJECT}.XXXXXX")
            { printf 'fingerprint: %s\n' "$fp"
              printf 'written: %s\n' "$(date '+%Y-%m-%d %H:%M')"
              printf 'tasks: %d\n' "${#done_files[@]}"
              printf 'runner: %s\n' "$HISTORY_RUNNER"
              printf 'model: %s\n' "${HISTORY_MODEL:-default}"
              printf '\n%s\n' "$text"; } > "$tmp"
            mv "$tmp" "$cache"
            old_fp="$fp"
        else
            why=$(tail -n 1 "$errf" 2>/dev/null || true)
        fi
        rm -f "$errf"
    fi

    _section "WHERE THINGS STAND"
    if [ ! -f "$cache" ]; then
        printf '  %sno summary yet: %s%s\n' "$YELLOW" "${why:-unknown error}" "$RESET"
        return 0
    fi
    note="written $(cache_field written "$cache"), from $(cache_field tasks "$cache") finished tasks"
    if [ "$old_fp" != "$fp" ]; then
        note="${YELLOW}STALE${RESET}${DIM}, $note; could not refresh: ${why:-unknown error}"
    fi
    printf '  %s(%b)%s\n' "$DIM" "$note" "$RESET"
    cache_text "$cache" | fold -s -w 78 | sed 's/^/  /'
}

if [ "$FACTS_ONLY" -eq 0 ]; then
    FACTS_PLAIN=$(BOLD="" RED="" GREEN="" YELLOW="" CYAN="" DIM="" RESET=""; print_facts)
    show_where_things_stand
fi
print_facts
