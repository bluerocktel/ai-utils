#!/bin/bash
# ai-task: run one queued task autonomously in a detached tmux session.
#
# Usage:
#   ai-task [--runner NAME] [task.md]   Launch a task. With no file argument,
#                                       picks the oldest inbox task that is
#                                       unblocked, using its configured runner.
#   ai-task [--runner NAME] --dry-run   Show what the picker would claim and
#                                       exit. Claims nothing, launches nothing.
#   ai-task --unblock SLUG              Move a task out of review/ back into
#                                       inbox/ and reset ## Retries to 0. Run
#                                       it AFTER fixing whatever sent it there.
#                                       Names the tasks it unblocks.
#   ai-task --run FILE [--runner NAME]  Internal mode used by tmux. Do not call
#                                       directly.
#
# Pipeline root: $TASKS_DIR (default ~/tasks). ONE tree serves every runner:
# the runner is a field on the task, not a separate directory tree.
#
# This file is PROVIDER-NEUTRAL by contract. It must never name a vendor, a
# vendor CLI, a vendor model id, a vendor CLI flag or a vendor JSON field.
# Everything that differs between runners goes through the six functions in
# providers/CONTRACT.md, loaded by load_provider.

set -euo pipefail

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib.sh"

usage() {
    sed -n '3,16p' "$(realpath "$0")" | sed 's/^# \{0,1\}//'
}

# ── Argument parsing ───────────────────────────────────────────────────────
# --runner may appear before or after --run / the task file, so both the
# launcher and the tmux child can be invoked with the same flag order.
MODE=launch
RUNNER_FLAG=""
TASK_ARG=""
DRY_RUN=0
UNBLOCK_SLUG=""

while [ $# -gt 0 ]; do
    case "$1" in
        --run)
            MODE=run
            TASK_ARG="${2:?--run requires a task file}"
            shift 2
            ;;
        --runner)
            RUNNER_FLAG="${2:?--runner requires a runner name}"
            shift 2
            ;;
        --runner=*)
            RUNNER_FLAG="${1#*=}"
            shift
            ;;
        --dry-run)
            DRY_RUN=1
            shift
            ;;
        --unblock)
            MODE=unblock
            UNBLOCK_SLUG="${2:?--unblock requires a task slug}"
            shift 2
            ;;
        --unblock=*)
            MODE=unblock
            UNBLOCK_SLUG="${1#*=}"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --*)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
        *)
            if [ -n "$TASK_ARG" ]; then
                echo "Unexpected extra argument: $1" >&2
                exit 1
            fi
            TASK_ARG="$1"
            shift
            ;;
    esac
done

# ── Config ─────────────────────────────────────────────────────────────────
MAX_RETRIES=3
TASK_TIMEOUT_MIN=45
PROJECT_LOCK_WAIT_MIN=60
AUTH_COOLDOWN_MIN=30
# The inbox lock is held for milliseconds (select + move), so a long wait here
# would only ever mean "another launcher is wedged". Seconds, not minutes.
INBOX_LOCK_WAIT_SEC=30
# Per-task follow-up suggester: on by default, capped low. See
# generate_suggestions below.
SUGGEST_ENABLED=1
SUGGEST_MAX=3

load_config
MAX_RETRIES=${max_retries:-$MAX_RETRIES}
TASK_TIMEOUT_MIN=${task_timeout_min:-$TASK_TIMEOUT_MIN}
PROJECT_LOCK_WAIT_MIN=${project_lock_wait_min:-$PROJECT_LOCK_WAIT_MIN}
AUTH_COOLDOWN_MIN=${auth_cooldown_min:-$AUTH_COOLDOWN_MIN}
SUGGEST_ENABLED=${suggest_enabled:-$SUGGEST_ENABLED}
SUGGEST_MAX=${suggest_max:-$SUGGEST_MAX}

# Prefix for write_stub's own messages (it lives in lib.sh and is shared with
# ai-scheduled, so it logs through this rather than through a local log()).
STUB_LOG_PREFIX="ai-task: "

# ── Shared helpers ─────────────────────────────────────────────────────────

# Runner for one task: an explicit --runner flag wins, otherwise the task's own
# ## Runner section, which itself falls back to default_runner from config.
# An unset ## Runner never means "any runner".
resolve_runner() {
    local task_file="${1:-}" r=""
    if [ -n "$RUNNER_FLAG" ]; then
        r="$RUNNER_FLAG"
    elif [ -n "$task_file" ] && [ -r "$task_file" ]; then
        r=$(runner_from_task "$task_file") || r=""
    else
        r="${default_runner:-}"
    fi
    r=$(printf '%s' "$r" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
    [ -n "$r" ] || return 1
    printf '%s\n' "$r"
}

# tmux session name. The runner is part of the name so two runners working the
# same tree can never collide on a session, and so `tmux ls` says who is who.
session_name() {
    local runner="$1" task_name="$2"
    printf '%s' "ai-${runner}-${task_name}" \
        | tr -c 'A-Za-z0-9_-' '-' \
        | cut -c1-50
}

# Sidecar state file for a claimed task. Additive (never a .md file, so no
# pipeline glob picks it up) and removed when the run ends. It exists so that
# `run/` shows WHICH runner owns an in-flight task now that one tree serves
# several of them.
run_state_path() {
    printf '%s\n' "$RUN_DIR/${1}.state"
}

write_run_state() {
    local task_name="$1" runner="$2" session="$3"
    {
        echo "task=${task_name}"
        echo "runner=${runner}"
        echo "session=${session}"
        echo "started=$(date '+%Y-%m-%d %H:%M:%S')"
    } > "$(run_state_path "$task_name")" 2>/dev/null || true
}

dep_satisfied() {
    local dep
    dep=$(depends_on_from_task "$1")
    [ -z "$dep" ] && return 0
    dep="${dep%.md}"
    find "$DONE_DIR" -maxdepth 1 -type f -name "*_${dep}.task.md" 2>/dev/null | grep -q .
}
# ── Per-task follow-up suggester ───────────────────────────────────────────
# Called ONLY from the verified-success branch (the run completed AND passed
# evaluation), and BEFORE the task file is archived, because it reads
# $TASK_FILE at its current path. Proposes follow-up task stubs into
# suggestions/, which is a reading pile the human promotes from: this is the
# only destination it has, and it must never gain a write path into inbox/ or
# the review queue.
#
# CROSS-PROJECT, BOUNDED BY THE ORIGIN'S DECLARED RELATIONSHIPS. A stub may
# target the origin project, or a project the origin names under
# ## Relationships, and nothing else. The bound is enforced by write_stub (it
# validates the stub's project: line against the permitted set and against the
# existence of that project's own file), not merely stated in the prompt.
#
# It reads the task file and its result report, never a git diff: a diff would
# include whatever a concurrent sibling task changed in the same tree.
#
# Runs on the EXECUTOR's provider with $MODEL_ID, exactly like the strategy
# pass: ai-eval runs as a separate process, so nothing has swapped the provider
# functions in this shell. Sets SUGGEST_COUNT; the caller invokes it as
# `generate_suggestions || true`, so a suggester failure can never keep a
# passing task out of done/.
#
# Relies on globals: PROJECT, TASK_FILE, TASK_NAME, RESULT_FILE, MODEL_ID,
# SUGGEST_ENABLED, SUGGEST_MAX, TASK_TIMEOUT_MIN.
generate_suggestions() {
    SUGGEST_COUNT=0
    [ "$SUGGEST_ENABLED" = "1" ] || return 0
    # No ## Project means no attribution for a stub, and no relationships to
    # bound it by. Silence is the right answer, not a guessed target.
    [ -n "$PROJECT" ] || return 0

    local allowed targets verb alias sug_json sug_err sug_text parse f written skipped
    allowed="$PROJECT"
    targets="- $PROJECT (kind: same-project)"
    while IFS=$'\t' read -r verb alias; do
        { [ -n "${verb:-}" ] && [ -n "${alias:-}" ]; } || continue
        # A declared alias with no project file of its own cannot be a target:
        # the stub would be attributed to a project that does not exist.
        [ -f "$PROJECTS_DIR/${alias}.md" ] || continue
        allowed="${allowed}"$'\n'"${alias}"
        targets="${targets}"$'\n'"- $alias (kind: $verb)"
    done < <(project_relationship_targets "$PROJECT")

    if [ "$allowed" = "$PROJECT" ]; then
        targets="${targets}"$'\n'"(The origin project declares no ## Relationships, so it is the ONLY permitted target.)"
    fi

    sug_json=$(mktemp)
    sug_err=$(mktemp)
    set +e
    ai_run "SUGGESTER MODE: A task just completed and PASSED evaluation in project '$PROJECT'. Propose the follow-up task stubs, if any, that the user may want to queue next.

Rules:
- Silence is the default. Only propose work you would genuinely bet is worth doing. Zero suggestions is a correct and common answer.
- Propose AT MOST $SUGGEST_MAX stubs.
- A stub may target the ORIGIN project or a project the origin declares under ## Relationships, and NO other project. The permitted targets, with the kind each one takes, are exactly:
$targets
- A 'mirror' target means a CODE task there: propagate this change to the equivalent surface. A 'content' target means a WRITING task there: a page, an article, a release note. Any other verb keeps its own name as the kind and means the same thing: what the origin owes that target.
- Never invent a target. A stub naming a project not listed above is discarded.
- Do NOT propose anything the result report already implies is done, and no trivial or obvious cleanup.
- Each stub must be concrete: a clear title, what to do, and acceptance criteria. Scope each to under ~5 files and split anything larger.
- Scope every acceptance criterion to what the task itself creates: no baseline-plus-predicted-delta totals, and no global invariant the task does not own.

Output ONLY the stubs, each fenced EXACTLY as below, with no preamble and no closing remark. If nothing is worth proposing, output the single line: NONE

===SUGGESTION===
slug: <kebab-case-unique-slug>
project: <one of the permitted targets above>
kind: <same-project, or that target's relationship verb>
---
# <Title>

## Project
<the same target project alias>

## Origin
Suggested after '$TASK_NAME' completed in '$PROJECT'.

<body: what to do, plus acceptance criteria>
===END===

--- ORIGINAL TASK ---
$(cat "$TASK_FILE")

--- RESULT REPORT (what was done) ---
$(cat "$RESULT_FILE")" \
        "$MODEL_ID" \
        "" \
        "$((TASK_TIMEOUT_MIN * 60))" \
        "$sug_json" \
        "$sug_err"
    set -e
    sug_text=$(ai_json_text "$sug_json")
    rm -f "$sug_json" "$sug_err"

    # An empty response and a bare NONE are both successful runs with zero
    # stubs. Neither is worth more than a log line.
    if [ -z "$sug_text" ]; then
        echo "ai-task: suggester returned nothing for '$TASK_NAME' — no follow-ups proposed"
        return 0
    fi
    if printf '%s' "$sug_text" | grep -qx 'NONE'; then
        echo "ai-task: suggester proposed no follow-ups for '$TASK_NAME'"
        return 0
    fi

    parse=$(mktemp -d)
    awk -v dir="$parse" '
        /^===SUGGESTION===/ { n++; cur = sprintf("%s/stub-%03d", dir, n); inblk = 1; next }
        /^===END===/ { inblk = 0; next }
        inblk { print > cur }
    ' <<< "$sug_text"

    written=0
    skipped=0
    for f in "$parse"/stub-*; do
        [ -f "$f" ] || continue
        if [ "$written" -ge "$SUGGEST_MAX" ]; then
            skipped=$((skipped + 1))
            continue
        fi
        if write_stub "$(cat "$f")" "$TASK_NAME" "$allowed"; then
            written=$((written + 1))
        else
            skipped=$((skipped + 1))
        fi
    done
    rm -rf "$parse"

    SUGGEST_COUNT="$written"
    # Never a silent cap, for the same reason as the planner's: the
    # suggestions directory would otherwise read as the model's whole opinion.
    echo "ai-task: suggester wrote $written follow-up(s) for '$TASK_NAME', $skipped skipped (cap $SUGGEST_MAX)"
}

# ═══════════════════════════════════════════════════════════════════════════
# Unblock mode: review/ → inbox/
# ═══════════════════════════════════════════════════════════════════════════
#
# The one supported way out of review/. A task lands there because a human has
# to look at it — a failed evaluation, or a criterion no correct run could
# satisfy — and everything downstream of it stops dead, because dep_satisfied
# accepts only done/*_<slug>.task.md.
#
# This does NOT judge whether the task was repaired: it cannot. The human edits
# the file first; an untouched criterion simply comes back to review/ on the
# next grade. What it does is make the requeue correct — the retry counter is
# reset, so a task that burned max_retries before a human fixed its criterion
# gets a full budget rather than landing straight back in review/ on its first
# FAIL.
#
# It makes no agent call and loads no provider: it is a file move.
if [ "$MODE" = "unblock" ]; then
    mkdir -p "$INBOX" "$REVIEW_DIR" "$LOCK_DIR"

    # Strip every path component and the extension, so the argument can never
    # steer the move outside review/ (same rule as ai-brief's filenames).
    SLUG=$(basename "${UNBLOCK_SLUG%.md}")
    if [ -z "$SLUG" ]; then
        echo "--unblock requires a task slug." >&2
        exit 1
    fi

    MATCHES=$(find "$REVIEW_DIR" -maxdepth 1 -type f \
                   \( -name "${SLUG}.md" -o -name "*_${SLUG}.md" \) 2>/dev/null | sort)
    MATCH_COUNT=$(printf '%s\n' "$MATCHES" | grep -c . || true)

    if [ "$MATCH_COUNT" -eq 0 ]; then
        echo "No task matching '$SLUG' in $REVIEW_DIR." >&2
        WHERE=$(locate_dep_slug "$SLUG")
        case "$WHERE" in
            missing) echo "That slug is nowhere in the pipeline." >&2 ;;
            *)       echo "It is currently in: $WHERE/" >&2 ;;
        esac
        exit 1
    fi

    # Two files for one slug means two dated attempts of the same task. Picking
    # one silently would requeue an arbitrary half of the history, so name them
    # and let the human say which.
    if [ "$MATCH_COUNT" -gt 1 ]; then
        echo "Ambiguous: '$SLUG' matches $MATCH_COUNT files in $REVIEW_DIR." >&2
        printf '%s\n' "$MATCHES" | sed 's/^/  - /' >&2
        echo "Pass the full basename instead." >&2
        exit 1
    fi

    REVIEW_FILE="$MATCHES"
    REVIEW_BASE=$(basename "$REVIEW_FILE")

    # Collected BEFORE the move: afterwards the dep resolves to inbox/ and
    # these tasks read as ordinary waiting, which is exactly the outcome, but
    # it would leave nothing to report.
    UNBLOCKED=""
    while IFS=$'\t' read -r b_task b_dep b_loc; do
        [ -n "$b_task" ] || continue
        [ "$b_loc" = "review" ] || continue
        [ "$b_dep" = "$SLUG" ] || continue
        UNBLOCKED="${UNBLOCKED}
  - ${b_task}"
    done < <(blocked_inbox_tasks)

    OLD_RETRIES=$(retries_from_task "$REVIEW_FILE")
    OLD_RETRIES=${OLD_RETRIES:-0}
    set_retries "$REVIEW_FILE" 0

    # The same lock every other write into inbox/ takes. It is held for the
    # move only, and a launcher mid-selection is unaffected either way.
    (
        exec 8>"$LOCK_DIR/inbox.lock"
        flock -w "$INBOX_LOCK_WAIT_SEC" 8 || exit 3
        mv "$REVIEW_FILE" "$INBOX/$REVIEW_BASE"
    ) || {
        echo "Could not take the inbox lock (waited ${INBOX_LOCK_WAIT_SEC}s). Nothing moved." >&2
        exit 1
    }

    echo "Unblocked: $REVIEW_BASE"
    echo "  review/ → inbox/"
    echo "  ## Retries reset: $OLD_RETRIES → 0"
    if [ -n "$UNBLOCKED" ]; then
        echo "  also unblocks:$UNBLOCKED"
    fi
    echo "Note: nothing here checked the task file. If the reason it reached"
    echo "review/ is still in it, the next evaluation sends it straight back."
    exit 0
fi

# ═══════════════════════════════════════════════════════════════════════════
# Internal execution mode
# ═══════════════════════════════════════════════════════════════════════════
if [ "$MODE" = "run" ]; then
    TASK_FILE="$TASK_ARG"
    if [ ! -f "$TASK_FILE" ]; then
        echo "Task file not found: $TASK_FILE" >&2
        exit 1
    fi
    TASK_NAME=$(basename "$TASK_FILE" .md)
    TIMESTAMP=$(date '+%Y-%m-%d_%H-%M')
    RESULT_FILE="$DONE_DIR/${TIMESTAMP}_${TASK_NAME}.md"

    if ! RUNNER=$(resolve_runner "$TASK_FILE"); then
        echo "No runner: task has no ## Runner section and config sets no default_runner." >&2
        exit 1
    fi
    # A half-defined or unknown adapter is fatal here, deliberately: falling
    # back to some default would hand the task to the wrong provider, and that
    # is the one mistake that cannot be undone afterwards.
    load_provider "$RUNNER" || exit 1

    COOLDOWN_FILE=$(cooldown_path "$RUNNER")
    STATE_FILE=$(run_state_path "$TASK_NAME")

    mkdir -p "$DONE_DIR" "$REVIEW_DIR" "$INBOX" "$RUN_DIR" "$LOCK_DIR"

    # Whatever happens below (success, requeue, review, crash), the in-flight
    # marker must not outlive the run.
    trap 'rm -f "$STATE_FILE"' EXIT
    write_run_state "$TASK_NAME" "$RUNNER" "$(session_name "$RUNNER" "$TASK_NAME")"

    # Requeue for a later attempt. Every deferral path ends here, so it must not
    # be able to fail: the launcher normally moves the task into run/ first, but
    # a direct `--run` on a file still sitting in inbox/ makes source and
    # destination the same path. `mv` errors on that, and under `set -e` the
    # abort happens BEFORE the notification and the log line, leaving a bare mv
    # complaint and no indication the task is still queued. Same hardening, and
    # the same reason, as restore_brief in ai-brief.
    requeue_task() {
        local dest="$INBOX/${TASK_NAME}.md"
        mkdir -p "$INBOX"
        [ -e "$TASK_FILE" ] || return 0
        if [ "$(realpath "$TASK_FILE")" = "$(realpath -m "$dest")" ]; then
            return 0
        fi
        mv "$TASK_FILE" "$dest"
    }

    PROJECT=$(project_from_task "$TASK_FILE")

    # ── Per-project exclusive lock ──────────────────────────────────────────
    # SHARED ACROSS RUNNERS on purpose: the lock file is derived from TASKS_DIR,
    # not from the runner, so two agents can never be inside the same repo at
    # once regardless of which provider each is using. A wait timeout is
    # DEFERRED, not a failure: no work happened, so no retry is burned.
    #
    # THE LOCK NAME IS RESOLVED, NOT THE RAW ## Project TOKEN. The name has to
    # be ONE PER REPOSITORY, and an alias is the same repository under another
    # spelling: a project file declaring demo-proj, demoproj and demo-project
    # points all three at one working directory, but the raw token gave each
    # its own lock file and so let two agents into that tree at once.
    # canonical_project collapses the declared aliases and sanitises the value,
    # which is otherwise interpolated unchecked into a path under $LOCK_DIR.
    # $PROJECT ITSELF IS UNTOUCHED: the project-file read, the prompt, the log
    # and DONE.md all keep the value the task actually wrote.
    if [ -n "$PROJECT" ]; then
        PROJECT_LOCK_NAME=$(canonical_project "$PROJECT")
        # Visible in cron.log rather than silent: a task locking under a name
        # it did not write is exactly the thing a human debugging a collision
        # needs to see.
        if [ "$PROJECT_LOCK_NAME" != "$PROJECT" ]; then
            echo "ai-task: project '$PROJECT' locks as '$PROJECT_LOCK_NAME' (declared alias of the same repository)"
        fi
        exec 9>"$LOCK_DIR/${PROJECT_LOCK_NAME}.lock"
        if ! flock -w "$((PROJECT_LOCK_WAIT_MIN * 60))" 9; then
            {
                echo "## $(date '+%Y-%m-%d %H:%M') - $TASK_NAME"
                echo ""
                echo "**Runner:** $RUNNER"
                echo "**Status:** DEFERRED (project '$PROJECT' busy — lock wait timed out, not counted as retry)"
                echo ""
            } >> "$LOG"
            requeue_task
            exit 0
        fi
    fi

    # ── Grade-only resume ───────────────────────────────────────────────────
    # A task carrying ## Awaiting-Eval already RAN: its report is in done/ and
    # only the verdict is missing (the grader hit an auth failure last time).
    # Skip the whole work phase and fall straight through to evaluation.
    #
    # A dangling pointer must never wedge a task, so a section naming a report
    # that is not there is stripped and the task runs normally.
    # The executor's model, resolved once. The alias table is per provider; an
    # empty result means "provider default" and the caller must not second-guess
    # it (providers genuinely differ on what unset means).
    #
    # Resolved OUTSIDE the work phase because the strategy pass on the FAIL path
    # uses it too, and that path is reachable from a grade-only resume that the
    # work phase never ran. Left inside, a resumed task failing its second
    # evaluation would abort on an unbound variable after its feedback had
    # already been appended, stranding it in run/.
    MODEL_RAW=$(model_from_task "$TASK_FILE")
    if [ -z "$MODEL_RAW" ]; then
        MODEL_RAW="${default_model:-}"
    fi
    MODEL_ID=$(ai_model_alias "$MODEL_RAW")

    GRADE_ONLY=0
    # The agent's exit status is set by the work phase, which a grade-only
    # resume skips entirely. It is still read when the verdict is logged, so it
    # has to exist on BOTH paths or `set -u` aborts after a successful grading
    # and the task is never archived: it stays in inbox/, graded but unfiled,
    # and the next sweep grades it all over again.
    STATUS=0
    AWAITING=$(awaiting_eval_from_task "$TASK_FILE")
    if [ -n "$AWAITING" ]; then
        AWAITING_PATH="$DONE_DIR/$(basename "$AWAITING")"
        if [ -f "$AWAITING_PATH" ]; then
            GRADE_ONLY=1
            RESULT_FILE="$AWAITING_PATH"
            # Reuse the ORIGINAL report's timestamp so the archived pair keeps
            # matching names (<ts>_<task>.md next to <ts>_<task>.task.md); a
            # fresh timestamp here would split the pair and break the
            # *_<slug>.task.md lookups that depend on it.
            AWAITING_BASE=$(basename "$AWAITING_PATH" .md)
            if [ "$AWAITING_BASE" != "${AWAITING_BASE%_$TASK_NAME}" ]; then
                TIMESTAMP="${AWAITING_BASE%_$TASK_NAME}"
            fi
            echo "Grade-only resume: report already exists, skipping execution ($RESULT_FILE)"
            {
                printf "\n---\n\n**Re-graded:** %s — execution was not repeated (grading had been deferred).\n" \
                    "$(date '+%Y-%m-%d %H:%M')"
            } >> "$RESULT_FILE"
        else
            echo "## Awaiting-Eval named '$AWAITING' but $AWAITING_PATH is gone — running the task normally." >&2
        fi
        strip_awaiting_eval_section "$TASK_FILE"
    fi

    if [ "$GRADE_ONLY" -eq 0 ]; then
        {
            echo "# $TASK_NAME"
            echo ""
            echo "**Runner:** $RUNNER"
            echo "**Started:** $(date '+%Y-%m-%d %H:%M')"
            echo ""
            echo "---"
            echo ""
        } > "$RESULT_FILE"

        # ── Prompt ──────────────────────────────────────────────────────────────
        # Vendor-neutral by contract. Anything naming a provider feature is
        # appended by ai_preamble_extra.
        PREAMBLE="AUTONOMOUS MODE: You have no user to interact with. Never ask questions, never present options (A/B/C), never wait for confirmation. Make the most reasonable decision and implement immediately. There is no event loop in this headless run: never wait on a monitored event, a scheduled wakeup, a task notification, or any asynchronous callback — those never fire here and the run will simply be killed. If a step needs test results or command output, run it SYNCHRONOUSLY, block on it, and read its output before continuing; if something genuinely cannot complete in one pass, finish now and record what remains in the ## Summary instead of parking to wait. Document choices in a ## Summary at the end. After the ## Summary, add a ## Suggested Commit Message section with a ready-to-use git commit message (subject + optional body) describing all changes. Do not run git commit yourself unless the task file explicitly requires it. CRITICAL: Never use git checkout, git restore, or git reset to undo a previous attempt's changes. Any untracked files or unstaged modifications in the working tree may be legitimate work from other concurrent tasks — do not delete or revert them. If you need to undo your own changes from a previous attempt, edit only the exact lines you added.

ACCEPTANCE CRITERIA: they define done, but they are not a licence to change anything this task was not asked to change. A criterion can be wrong: its arithmetic can be off, it can assert something about data or files outside this task's scope, or it can contradict another criterion. When a criterion cannot be satisfied by doing the task correctly, do NOT force it. Never delete, overwrite or restructure data, files or schema outside the task's stated scope to make a check pass, and never create a record whose only purpose is to move a count. Do the task correctly, leave the pre-existing state exactly as you found it, and report the conflict in the ## Summary: name the criterion, show the arithmetic or the query that disproves it, say what the correct value is, and state the decision the user has to make. An unsatisfiable criterion is a defect in the task file; reporting it precisely is the right outcome and is far more useful than a check forced green. If a previous attempt already made such an out-of-scope change (look for it in ## Evaluator Feedback), undo that change as part of this attempt and say so."

        WORKDIR=""
        if [ -n "$PROJECT" ] && [ -f "$PROJECTS_DIR/${PROJECT}.md" ]; then
            PREAMBLE="$PREAMBLE

PROJECT CONTEXT: Before doing anything else, read the project file at $PROJECTS_DIR/${PROJECT}.md and follow its Working Directory, stack notes, and conventions. Task type (code vs writing) is defined there."
            if WD=$(project_working_dir "$PROJECT"); then
                if [ -d "$WD" ]; then
                    WORKDIR="$WD"
                fi
            fi
        fi

        PROJECT_INSTRUCTIONS=$(project_instructions "$PROJECT")
        if [ -n "$PROJECT_INSTRUCTIONS" ]; then
            PREAMBLE="$PREAMBLE

$PROJECT_INSTRUCTIONS"
        fi

        EXTRA=$(ai_preamble_extra "$TASK_FILE" || true)
        if [ -n "$EXTRA" ]; then
            PREAMBLE="$PREAMBLE

$EXTRA"
        fi

        # ── Model ───────────────────────────────────────────────────────────────
        JSON_TMP=$(mktemp)
        ERR_TMP=$(mktemp)
        USAGE_TMP=$(mktemp)
        BODY_TMP=$(mktemp)

        # The provider owns the timeout wrapper and returns the CLI status verbatim,
        # including 124 for a timeout. stdout and stderr land in two SEPARATE files;
        # merging them would corrupt the JSON and silently blank the report.
        set +e
        ai_run "${PREAMBLE}

$(cat "$TASK_FILE")" \
            "$MODEL_ID" \
            "$WORKDIR" \
            "$((TASK_TIMEOUT_MIN * 60))" \
            "$JSON_TMP" \
            "$ERR_TMP"
        STATUS=$?
        set -e

        # ── Auth-failure circuit breaker ────────────────────────────────────────
        # An auth failure means NO WORK HAPPENED: requeue without burning a retry
        # and pause only THIS runner's queue (the marker is per runner).
        if ai_is_auth_failure "$JSON_TMP" || ai_is_auth_failure "$ERR_TMP"; then
            {
                echo "Deferred: authentication failure (no work performed, retry not counted)."
                ai_json_text "$JSON_TMP"
                echo ""
                echo "---"
                echo ""
                echo "**Deferred:** $(date '+%Y-%m-%d %H:%M') — requeued to inbox pending re-authentication."
            } >> "$RESULT_FILE"
            {
                echo "## $(date '+%Y-%m-%d %H:%M') - $TASK_NAME"
                echo ""
                echo "**Runner:** $RUNNER"
                echo "**Status:** DEFERRED (auth failure — not counted as retry)"
                echo "**Result:** \`$RESULT_FILE\`"
                echo ""
            } >> "$LOG"
            touch "$COOLDOWN_FILE"
            requeue_task
            rm -f "$JSON_TMP" "$ERR_TMP" "$USAGE_TMP" "$BODY_TMP"
            notify -u critical "ai-task [$RUNNER]: Auth Failure" \
                "$TASK_NAME deferred — re-authenticate this runner. Its queue is paused for the cooldown."
            exit 0
        fi

        rm -f "$COOLDOWN_FILE"

        # ── Killed / interrupted run (no parseable result text) ─────────────────
        # DEFERRED, not FAIL: an interrupted run proves nothing about the task.
        if [ "$STATUS" -ne 0 ] && [ -z "$(ai_json_text "$JSON_TMP")" ]; then
            if [ "$STATUS" -eq 124 ]; then
                INTERRUPT_REASON="timed out after ${TASK_TIMEOUT_MIN}m"
            else
                INTERRUPT_REASON="interrupted (exit code $STATUS)"
            fi
            {
                echo "Deferred: run $INTERRUPT_REASON, no output — retry not counted."
                echo ""
                if [ -s "$ERR_TMP" ]; then
                    echo "_stderr:_"
                    echo '```'
                    cat "$ERR_TMP"
                    echo '```'
                    echo ""
                fi
                echo "---"
                echo ""
                echo "**Deferred:** $(date '+%Y-%m-%d %H:%M') — requeued to inbox (killed/interrupted run)."
            } >> "$RESULT_FILE"
            {
                echo "## $(date '+%Y-%m-%d %H:%M') - $TASK_NAME"
                echo ""
                echo "**Runner:** $RUNNER"
                echo "**Status:** DEFERRED (run $INTERRUPT_REASON — not counted as retry)"
                echo "**Result:** \`$RESULT_FILE\`"
                echo ""
            } >> "$LOG"
            requeue_task
            rm -f "$JSON_TMP" "$ERR_TMP" "$USAGE_TMP" "$BODY_TMP"
            notify -u critical "ai-task [$RUNNER]: Task Interrupted" \
                "$TASK_NAME $INTERRUPT_REASON — requeued, no retry burned."
            exit 0
        fi

        RESULT_TEXT=$(ai_json_text "$JSON_TMP")
        if [ -z "$RESULT_TEXT" ] && { [ -s "$JSON_TMP" ] || [ -s "$ERR_TMP" ]; }; then
            {
                echo "> [ai-task] WARNING: could not parse the runner's JSON output (no response text)."
                echo "> Raw stdout and stderr captures follow."
                echo ""
                echo "_stdout:_"
                echo '```'
                cat "$JSON_TMP"
                echo '```'
                echo ""
                echo "_stderr:_"
                echo '```'
                cat "$ERR_TMP"
                echo '```'
            } > "$BODY_TMP"
        else
            printf '%s\n' "$RESULT_TEXT" > "$BODY_TMP"
        fi

        # Cost reporting never fails a task, so the table is written unconditionally.
        ai_usage_table "$JSON_TMP" "$USAGE_TMP" || true

        if grep -q "^## Suggested Commit Message" "$BODY_TMP" 2>/dev/null; then
            awk -v tf="$USAGE_TMP" '
                /^## Suggested Commit Message/ {
                    while ((getline line < tf) > 0) print line
                    close(tf)
                    print ""
                }
                { print }
            ' "$BODY_TMP" >> "$RESULT_FILE"
        else
            cat "$BODY_TMP" >> "$RESULT_FILE"
            echo "" >> "$RESULT_FILE"
            cat "$USAGE_TMP" >> "$RESULT_FILE"
        fi

        rm -f "$JSON_TMP" "$ERR_TMP" "$USAGE_TMP" "$BODY_TMP"

        {
            echo ""
            echo "---"
            echo ""
            echo "**Finished:** $(date '+%Y-%m-%d %H:%M')"
        } >> "$RESULT_FILE"
    fi   # end of the work phase (skipped entirely on a grade-only resume)

    # ── Evaluation ──────────────────────────────────────────────────────────
    # Exit codes: 0 pass, 1 fail, 2 nothing to grade, 3 evaluator auth failure,
    # 4 test command timed out, 5 = ai-eval returned VERDICT: UNSATISFIABLE.
    #
    # The grader is `eval_runner` when config sets one, else the runner that
    # executed the task. A DIFFERENT provider is the useful configuration: the
    # value of a second opinion comes from its failure modes being independent,
    # and a grader sharing the executor's training shares its blind spots.
    #
    # AI_RUNNER is still exported, but it now records who EXECUTED rather than
    # choosing who grades: --runner sits above it in ai-eval's precedence, so
    # the explicit flag below is what takes effect. A hand-run ai-eval with
    # neither still lands on eval_runner, then default_runner.
    EVAL_RUNNER="${eval_runner:-$RUNNER}"
    EVAL_COOLDOWN_FILE=$(cooldown_path "$EVAL_RUNNER")
    EVAL_BIN="$HOME/bin/ai-eval"
    if [ ! -x "$EVAL_BIN" ]; then
        EVAL_BIN="$SCRIPT_DIR/ai-eval"
    fi
    EVAL_OUTPUT=$(mktemp)

    if [ ! -x "$EVAL_BIN" ]; then
        # No evaluator installed yet: nothing to grade, so the run stands.
        echo "_No evaluator available ($EVAL_BIN); result not graded._" >> "$RESULT_FILE"
        EVAL_STATUS=2
    else
        set +e
        AI_RUNNER="$RUNNER" "$EVAL_BIN" --runner "$EVAL_RUNNER" \
            "$TASK_FILE" "$RESULT_FILE" "$EVAL_OUTPUT"
        EVAL_STATUS=$?
        set -e
    fi

    if [ "$EVAL_STATUS" -eq 3 ]; then
        {
            echo "## $(date '+%Y-%m-%d %H:%M') - $TASK_NAME"
            echo ""
            echo "**Runner:** $RUNNER"
            [ "$EVAL_RUNNER" != "$RUNNER" ] && echo "**Graded by:** $EVAL_RUNNER"
            echo "**Status:** DEFERRED (evaluator auth failure on '$EVAL_RUNNER' — not counted as retry)"
            echo "**Result:** \`$RESULT_FILE\`"
            echo ""
        } >> "$LOG"
        # The GRADER's marker, not the executor's. These are the same runner
        # only when eval_runner is unset; with a split, pausing $RUNNER here
        # would stop a queue whose credentials are perfectly fine, which is
        # exactly what the per-runner marker exists to prevent.
        touch "$EVAL_COOLDOWN_FILE"
        # The work is finished and the report is on disk. Point the task at it
        # so the next claim GRADES it instead of executing it a second time:
        # without this, a grader outage silently converts a completed run into
        # a full re-run, and the split would cost more than it is worth.
        set_awaiting_eval "$TASK_FILE" "$(basename "$RESULT_FILE")"
        requeue_task
        rm -f "$EVAL_OUTPUT"
        notify -u critical "ai-task [$EVAL_RUNNER]: Evaluator Auth Failure" \
            "$TASK_NAME ran fine but could not be graded (auth on '$EVAL_RUNNER'). Work kept; grading deferred."
        exit 0
    fi

    if [ "$EVAL_STATUS" -eq 4 ]; then
        {
            printf "\n---\n\n## Evaluator (inconclusive)\n\n"
            cat "$EVAL_OUTPUT"
        } >> "$RESULT_FILE"
        {
            echo "## $(date '+%Y-%m-%d %H:%M') - $TASK_NAME"
            echo ""
            echo "**Runner:** $RUNNER"
            [ "$EVAL_RUNNER" != "$RUNNER" ] && echo "**Graded by:** $EVAL_RUNNER"
            echo "**Status:** DEFERRED (test command timed out — not counted as retry)"
            echo "**Result:** \`$RESULT_FILE\`"
            echo ""
        } >> "$LOG"
        requeue_task
        rm -f "$EVAL_OUTPUT"
        notify "ai-task [$RUNNER]: Eval Timed Out" \
            "$TASK_NAME verification timed out — requeued, no retry burned."
        exit 0
    fi

    # Exit 5 = VERDICT: UNSATISFIABLE. The evaluator found a criterion that no
    # correct execution of this task could satisfy, and backed it with a command
    # and its output. What is wrong is the TASK FILE, so no number of retries
    # can turn it green: falling through to the FAIL path below would spend
    # every remaining attempt rediscovering the same defective criterion and
    # then land here anyway, three runs later. The retry counter is deliberately
    # neither read nor written on this path: the attempt that produced the
    # evidence did its job.
    if [ "$EVAL_STATUS" -eq 5 ]; then
        {
            printf "\n---\n\n## Evaluator (unsatisfiable acceptance criteria)\n\n"
            cat "$EVAL_OUTPUT"
        } >> "$RESULT_FILE"

        {
            echo "## $(date '+%Y-%m-%d %H:%M') - $TASK_NAME"
            echo ""
            echo "**Runner:** $RUNNER"
            [ "$EVAL_RUNNER" != "$RUNNER" ] && echo "**Graded by:** $EVAL_RUNNER"
            echo "**Status:** NEEDS REVIEW (unsatisfiable acceptance criteria — no retry burned)"
            echo "**Result:** \`$RESULT_FILE\`"
            echo ""
        } >> "$LOG"

        mv "$TASK_FILE" "$REVIEW_DIR/${TASK_NAME}.md"
        rm -f "$EVAL_OUTPUT"
        notify -u critical "ai-task [$RUNNER]: Unsatisfiable Criteria" \
            "$TASK_NAME cannot pass as written. The TASK FILE needs fixing, not the code — see ## Unsatisfiable Criteria in the report. Moved to review/, no retry burned."
        exit 1
    fi

    # Exit 2 = no acceptance criteria and no tests: nothing to grade, so pass.
    if [ "$EVAL_STATUS" -eq 2 ]; then
        EVAL_STATUS=0
    fi

    if [ "$EVAL_STATUS" -eq 1 ]; then
        RETRIES=$(retries_from_task "$TASK_FILE")
        RETRIES=${RETRIES:-0}

        if [ "$RETRIES" -lt "$MAX_RETRIES" ]; then
            NEW_RETRIES=$((RETRIES + 1))

            {
                printf "\n## Evaluator Feedback (Attempt %s)\n\n" "$NEW_RETRIES"
                cat "$EVAL_OUTPUT"
                printf "\n"
            } >> "$TASK_FILE"

            set_retries "$TASK_FILE" "$NEW_RETRIES"

            # Strategy pass from the second failure on: the same approach has
            # now failed twice, so ask for a different one before requeueing.
            if [ "$NEW_RETRIES" -ge 2 ]; then
                STRATEGY_JSON=$(mktemp)
                STRATEGY_ERR=$(mktemp)
                set +e
                ai_run "STRATEGY MODE: This task has failed evaluation $NEW_RETRIES times. Diagnose the recurring failure pattern and suggest a concrete alternative approach for the next attempt.

Rules:
- Read the original task instructions and all ## Evaluator Feedback sections carefully.
- Identify what keeps going wrong: wrong approach, misread requirement, missing step, environment issue?
- Suggest a specific, different strategy. Name files, methods, commands, or patterns to try instead.
- Be concrete and actionable. Under 10 lines. No praise, no preamble, no closing remark.
- If the recurring failure is a criterion that CANNOT be satisfied by doing the task correctly, say exactly that and recommend stopping rather than retrying: name the criterion, give the arithmetic or query that disproves it, and name the decision the user must make. Never propose satisfying a criterion by deleting or restructuring data outside the task's scope, by creating a record whose only purpose is to move a count, or by any workaround that leaves the system worse than the honest shortfall. If an earlier attempt did one of those, the strategy is to undo it.
- Output only raw Markdown starting with exactly: ## Retry Strategy (Attempt $NEW_RETRIES)

---
$(cat "$TASK_FILE")" \
                    "$MODEL_ID" \
                    "" \
                    "$((TASK_TIMEOUT_MIN * 60))" \
                    "$STRATEGY_JSON" \
                    "$STRATEGY_ERR"
                set -e
                STRATEGY_TEXT=$(ai_json_text "$STRATEGY_JSON")
                rm -f "$STRATEGY_JSON" "$STRATEGY_ERR"
                if [ -n "$STRATEGY_TEXT" ]; then
                    printf '\n%s\n' "$STRATEGY_TEXT" >> "$TASK_FILE"
                fi
            fi

            {
                echo "## $(date '+%Y-%m-%d %H:%M') - $TASK_NAME"
                echo ""
                echo "**Runner:** $RUNNER"
                [ "$EVAL_RUNNER" != "$RUNNER" ] && echo "**Graded by:** $EVAL_RUNNER"
                echo "**Status:** requeued (retry $NEW_RETRIES/$MAX_RETRIES)"
                echo "**Result:** \`$RESULT_FILE\`"
                echo ""
            } >> "$LOG"

            requeue_task
            rm -f "$EVAL_OUTPUT"
            notify "ai-task [$RUNNER]: Task Requeued" \
                "$TASK_NAME failed evaluation (retry $NEW_RETRIES/$MAX_RETRIES). Requeued."
            exit 0
        else
            {
                printf "\n---\n\n## Evaluator Feedback (Final Attempt)\n\n"
                cat "$EVAL_OUTPUT"
            } >> "$RESULT_FILE"

            {
                echo "## $(date '+%Y-%m-%d %H:%M') - $TASK_NAME"
                echo ""
                echo "**Runner:** $RUNNER"
                [ "$EVAL_RUNNER" != "$RUNNER" ] && echo "**Graded by:** $EVAL_RUNNER"
                echo "**Status:** NEEDS REVIEW (failed after $MAX_RETRIES retries)"
                echo "**Result:** \`$RESULT_FILE\`"
                echo ""
            } >> "$LOG"

            mv "$TASK_FILE" "$REVIEW_DIR/${TASK_NAME}.md"
            rm -f "$EVAL_OUTPUT"
            notify -u critical "ai-task [$RUNNER]: Needs Review" \
                "$TASK_NAME failed evaluation after $MAX_RETRIES retries."
            exit 1
        fi
    fi

    rm -f "$EVAL_OUTPUT"

    {
        echo "## $(date '+%Y-%m-%d %H:%M') - $TASK_NAME"
        echo ""
        echo "**Runner:** $RUNNER"
        [ "$EVAL_RUNNER" != "$RUNNER" ] && echo "**Graded by:** $EVAL_RUNNER"
        if [ "$GRADE_ONLY" -eq 1 ]; then
            echo "**Status:** completed (graded on a later pass; execution not repeated)"
        elif [ "$STATUS" -eq 0 ]; then
            echo "**Status:** completed"
        else
            echo "**Status:** completed with agent exit $STATUS (eval PASS)"
        fi
        echo "**Result:** \`$RESULT_FILE\`"
        echo ""
    } >> "$LOG"

    # BEFORE the archival mv: the suggester reads $TASK_FILE at its current
    # path. `|| true` on purpose — a suggester failure must never keep a task
    # that passed out of done/.
    SUGGEST_COUNT=0
    generate_suggestions || true

    mv "$TASK_FILE" "$DONE_DIR/${TIMESTAMP}_${TASK_NAME}.task.md"
    DONE_MSG="$TASK_NAME completed successfully."
    if [ "$SUGGEST_COUNT" -gt 0 ]; then
        DONE_MSG="$DONE_MSG $SUGGEST_COUNT follow-up suggestion(s) in suggestions/."
    fi
    notify "ai-task [$RUNNER]: Task Done" "$DONE_MSG"
    exit 0
fi

# ═══════════════════════════════════════════════════════════════════════════
# Launcher mode
# ═══════════════════════════════════════════════════════════════════════════
mkdir -p "$INBOX" "$RUN_DIR" "$DONE_DIR" "$REVIEW_DIR" "$LOCK_DIR"

# Without --runner, dispatch each task using its own runner. An explicit flag
# restricts queue selection; named files still allow overriding their runner.
INVOCATION_RUNNER=""
if [ -n "$RUNNER_FLAG" ]; then
    INVOCATION_RUNNER=$(resolve_runner "") || exit 1
    ( load_provider "$INVOCATION_RUNNER" >/dev/null ) || exit 1
fi

runner_available() {
    local marker
    marker=$(cooldown_path "$1") || return 1
    [ -f "$marker" ] || return 0
    if find "$marker" -mmin -"$AUTH_COOLDOWN_MIN" 2>/dev/null | grep -q .; then
        return 1
    fi
    return 0
}

# Keep the explicit runner's cooldown message. Automatic selection checks
# cooldowns per candidate so a paused provider cannot stop another queue.
# Named files bypass cooldowns for manual retries after re-authentication.
if [ -z "$TASK_ARG" ] && [ -n "$INVOCATION_RUNNER" ] \
    && ! runner_available "$INVOCATION_RUNNER"; then
    echo "Auth cooldown active for runner '$INVOCATION_RUNNER' (last failure < ${AUTH_COOLDOWN_MIN}m ago). Skipping."
    echo "Re-authenticate, then run a task manually or: rm $(cooldown_path "$INVOCATION_RUNNER")"
    exit 0
fi

# ── Eligibility ────────────────────────────────────────────────────────────
runner_matches() {
    [ -z "$INVOCATION_RUNNER" ] && return 0
    local r
    r=$(runner_from_task "$1") || return 1
    [ "$r" = "$INVOCATION_RUNNER" ]
}

# A task carrying ## Awaiting-Eval needs nothing but a verdict, so it is
# claimable only while its GRADER is actually available.
#
# This is a starvation guard, not an optimisation. The picker returns the FIRST
# eligible task, and a grade-only resume defers again within seconds while the
# grader is in cooldown. Without this check, one task waiting on a down judge
# would be claimed on every single sweep and nothing behind it in the queue
# would ever run. A task not awaiting a verdict is unaffected.
grader_available() {
    local f="$1" r g marker
    [ -n "$(awaiting_eval_from_task "$f")" ] || return 0
    r=$(runner_from_task "$f") || return 0
    g="${eval_runner:-$r}"
    marker=$(cooldown_path "$g") || return 0
    [ -f "$marker" ] || return 0
    if find "$marker" -mmin -"$AUTH_COOLDOWN_MIN" 2>/dev/null | grep -q .; then
        return 1
    fi
    return 0
}

# Oldest first, mtime order, whitespace-safe.
inbox_by_age() {
    find "$INBOX" -maxdepth 1 -type f -name '*.md' -printf '%T@ %p\n' 2>/dev/null \
        | sort -n \
        | cut -d' ' -f2-
}

select_candidate() {
    local f r
    while IFS= read -r f; do
        [ -n "$f" ] && [ -f "$f" ] || continue
        dep_satisfied "$f" || continue
        runner_matches "$f" || continue
        r=$(runner_from_task "$f") || {
            echo "No runner for '$f': set ## Runner or default_runner." >&2
            continue
        }
        ( load_provider "$r" >/dev/null ) || continue
        runner_available "$r" || continue
        grader_available "$f" || continue
        # An existing session for this name means a previous attempt is still
        # in flight; leave the file alone rather than run it twice.
        tmux has-session -t "$(session_name "$r" "$(basename "$f" .md)")" 2>/dev/null && continue
        printf '%s\n' "$f"
        return 0
    done < <(inbox_by_age)
    return 1
}

# ── Blocked-chain reporting ────────────────────────────────────────────────
#
# select_candidate skips a blocked task in silence and claims the next eligible
# one, so a queue holding any other runnable work never mentions the block. The
# dependent sits in inbox/ looking healthy while its parent is in review/ and
# nothing will ever satisfy it.
#
# The dep classification comes from blocked_inbox_tasks in lib.sh, which dtask
# also reads. One classifier, so the dashboard and the launcher cannot drift
# into disagreeing about which tasks are blocked.
#
# Two modes:
#   full       every category, plus the critical notifications. Used on the
#              "nothing eligible" branch, where this text is the only thing the
#              sweep produces.
#   dead-only  the permanently-blocked categories, no notification. Used after
#              a successful claim: work IS happening, so the sweep already has
#              something to say, and a chain that will still be dead in fifteen
#              minutes must not fire a critical notification on every sweep.
#              That volume is how a real alert gets muted.
report_blocked_chains() {
    local mode="${1:-full}" f name d loc
    local dead="" missing="" waiting="" other=""

    while IFS=$'\t' read -r name d loc; do
        [ -n "$name" ] || continue
        [ -f "$INBOX/${name}.md" ] || continue
        # A task belonging to another runner is that runner's business, and is
        # reported as such (full mode only), never as a blocked chain.
        runner_matches "$INBOX/${name}.md" || continue
        case "$loc" in
            review)
                dead="${dead}
  - ${name} → dep '${d}' is in review/ (failed)"
                ;;
            missing)
                missing="${missing}
  - ${name} → dep '${d}' is not in inbox/, run/, done/, or review/"
                ;;
            *)
                waiting="${waiting}
  - ${name} → dep '${d}' ($loc)"
                ;;
        esac
    done < <(blocked_inbox_tasks)

    if [ "$mode" = "dead-only" ]; then
        if [ -n "$dead" ]; then
            echo "Dead dependency chains (dependency failed to review/):$dead"
            echo "Clear one with: ai-task --unblock <parent-slug> (after fixing the parent)."
        fi
        if [ -n "$missing" ]; then
            echo "Missing dependencies (slug was never created):$missing"
        fi
        return 0
    fi

    while IFS= read -r f; do
        [ -n "$f" ] && [ -f "$f" ] || continue
        runner_matches "$f" && continue
        other="${other}
  - $(basename "$f" .md) → runner '$(runner_from_task "$f" || echo unresolved)'"
    done < <(inbox_by_age)

    if [ -n "$other" ]; then
        echo "Belongs to another runner (left untouched):$other"
    fi
    if [ -n "$dead" ]; then
        echo "Dead dependency chains (dependency failed to review/):$dead"
        echo "Clear one with: ai-task --unblock <parent-slug> (after fixing the parent)."
        notify -u critical "ai-task [${INVOCATION_RUNNER:-automatic}]: Tasks Permanently Blocked" \
            "One or more inbox tasks depend on a task that failed to review/."
    fi
    if [ -n "$missing" ]; then
        echo "Missing dependencies (slug was never created):$missing"
        notify -u critical "ai-task [${INVOCATION_RUNNER:-automatic}]: Tasks Permanently Blocked" \
            "One or more inbox tasks depend on a task that does not exist."
    fi
    if [ -n "$waiting" ]; then
        echo "Waiting on other queued tasks:$waiting"
    fi
    if [ -z "$dead" ] && [ -z "$missing" ] && [ -n "$waiting" ]; then
        echo "No runnable root: every task waits on another still-queued task (possible cycle)."
        notify -u critical "ai-task [${INVOCATION_RUNNER:-automatic}]: Tasks Permanently Blocked" \
            "Inbox has no runnable root (possible dependency cycle)."
    fi
    return 0
}

# ── Dry run: selection only, claims nothing ────────────────────────────────
if [ "$DRY_RUN" -eq 1 ]; then
    if [ -n "$TASK_ARG" ]; then
        echo "--dry-run does not take a task file argument" >&2
        exit 1
    fi
    if PICK=$(select_candidate); then
        echo "runner: $(resolve_runner "$PICK")"
        echo "would claim: $PICK"
        exit 0
    fi
    echo "runner: ${INVOCATION_RUNNER:-automatic}"
    echo "would claim: (nothing eligible)"
    exit 1
fi

# ── Atomic claim ───────────────────────────────────────────────────────────
# NEW: select-and-move happens under an exclusive lock on
# $TASKS_DIR/.locks/inbox.lock, so two invocations (two runners on different
# cron intervals, or two hand-runs) can never both walk away with the same
# file. Without it, both could select the same path and both `mv` it, and the
# loser's mv would fail or, worse, succeed after the winner had already started.
#
# The lock covers ONLY select + move + state marker: it is held for
# milliseconds and is released when this subshell exits, well before the agent
# call below. It must never wrap the run itself, or it would serialise all work
# across the whole queue.
claim() {
    local f dest task_name session file_runner
    if [ -n "$TASK_ARG" ]; then
        f="$TASK_ARG"
        [ -f "$f" ] || { echo "Task file not found: $f" >&2; return 4; }
        if ! dep_satisfied "$f"; then
            return 5
        fi
        # An explicitly named file is run as asked: the runner filter is a
        # queue-picking rule, not a permission check.
        task_name=$(basename "$f" .md)
        file_runner=$(resolve_runner "$f") || return 6
        ( load_provider "$file_runner" >/dev/null ) || return 10
        session=$(session_name "$file_runner" "$task_name")
        if tmux has-session -t "$session" 2>/dev/null; then
            echo "Session '$session' already running. Attach: tmux attach -t $session" >&2
            return 7
        fi
        if [ "$(dirname "$(realpath "$f")")" != "$(realpath "$RUN_DIR")" ]; then
            dest="$RUN_DIR/$(basename "$f")"
            mv "$f" "$dest" || return 8
        else
            dest="$f"
        fi
        write_run_state "$task_name" "$file_runner" "$session"
        printf '%s\n%s\n' "$dest" "$file_runner"
        return 0
    fi

    f=$(select_candidate) || return 1
    file_runner=$(resolve_runner "$f") || return 6
    task_name=$(basename "$f" .md)
    dest="$RUN_DIR/$(basename "$f")"
    [ -e "$dest" ] && return 9
    mv "$f" "$dest" || return 8
    session=$(session_name "$file_runner" "$task_name")
    write_run_state "$task_name" "$file_runner" "$session"
    printf '%s\n%s\n' "$dest" "$file_runner"
    return 0
}

CLAIM_OUT=$(mktemp)
set +e
(
    exec 8>"$LOCK_DIR/inbox.lock"
    flock -w "$INBOX_LOCK_WAIT_SEC" 8 || exit 3
    claim
)> "$CLAIM_OUT"
CLAIM_STATUS=$?
set -e
# Lock released above: everything from here on runs unlocked.

TASK_FILE=$(sed -n '1p' "$CLAIM_OUT")
EFFECTIVE_RUNNER=$(sed -n '2p' "$CLAIM_OUT")
rm -f "$CLAIM_OUT"

case "$CLAIM_STATUS" in
    0) : ;;
    3)
        echo "Another launcher is holding the inbox lock (waited ${INBOX_LOCK_WAIT_SEC}s). Skipping."
        exit 0
        ;;
    5)
        DEP=$(depends_on_from_task "$TASK_ARG")
        echo "Task blocked: depends on '${DEP%.md}' which is not yet in done/."
        exit 1
        ;;
    6)
        echo "No runner for '$TASK_ARG': no ## Runner section and no default_runner in config." >&2
        exit 1
        ;;
    4|7|8|9|10)
        exit 1
        ;;
    *)
        # Nothing eligible for this runner: explain why, from outside the lock.
        if find "$INBOX" -maxdepth 1 -type f -name '*.md' 2>/dev/null | grep -q .; then
            BLOCKED_COUNT=$(find "$INBOX" -maxdepth 1 -type f -name '*.md' 2>/dev/null | wc -l)
            if [ -n "$INVOCATION_RUNNER" ]; then
                echo "Nothing runnable for runner '$INVOCATION_RUNNER' among $BLOCKED_COUNT task(s) in $INBOX."
            else
                echo "Nothing runnable among $BLOCKED_COUNT task(s) in $INBOX (checked each task's runner)."
            fi
            report_blocked_chains full
        else
            echo "Usage: ai-task [--runner NAME] [task.md]"
            echo "No .md task file found in $INBOX"
        fi
        exit 1
        ;;
esac

if [ -z "$TASK_FILE" ] || [ -z "$EFFECTIVE_RUNNER" ]; then
    echo "Claim produced no task file (internal error)." >&2
    exit 1
fi

TASK_NAME=$(basename "$TASK_FILE" .md)
SESSION=$(session_name "$EFFECTIVE_RUNNER" "$TASK_NAME")

# A claim succeeded, but the rest of the inbox may still hold chains that can
# never run. Reported here so cron.log carries them on EVERY sweep, not only on
# the sweeps that happen to find nothing eligible — with other runnable work
# present, the idle branch above is never reached and a dead chain stays
# invisible indefinitely. Dead-only and deliberately without a notification:
# see report_blocked_chains.
report_blocked_chains dead-only

SELF_BIN="$HOME/bin/ai-task"
if [ ! -x "$SELF_BIN" ]; then
    SELF_BIN="$SCRIPT_DIR/ai-task"
fi

# TASKS_DIR is passed explicitly: the tmux server has its own environment, so a
# tree override on this invocation would otherwise be lost and the child would
# work against the default tree. That would make a throwaway smoke run touch
# the live queue.
tmux new-session -d -s "$SESSION" bash -lc \
    "TASKS_DIR=$(printf '%q' "$TASKS_DIR") $(printf '%q' "$SELF_BIN") --run $(printf '%q' "$TASK_FILE") --runner $(printf '%q' "$EFFECTIVE_RUNNER")"

echo "Task '$TASK_NAME' started in tmux session '$SESSION' (runner: $EFFECTIVE_RUNNER)."
echo "Monitor : tmux attach -t $SESSION"
echo "Result  : $DONE_DIR/*_${TASK_NAME}.md"
