#!/bin/bash
# ai-eval: evaluate a completed task against its acceptance criteria.
#
# Usage:
#   ai-eval [--runner NAME] TASK_FILE RESULT_FILE [OUTPUT_FILE]
#
# Exit codes (LOAD-BEARING: ai-task branches on every one of them to decide
# whether an attempt burns a retry, so none of these may be renumbered):
#   0 = PASS
#   1 = FAIL
#   2 = no ## Acceptance Criteria and no passing ## Test Command
#       (nothing to grade: skip evaluation; also usage errors and a missing
#        task or result file, so a bad invocation never reads as a FAIL)
#   3 = inconclusive: evaluator auth failure or empty verdict
#       (do NOT burn a retry)
#   4 = inconclusive: a ## Test Command timed out
#       (do NOT burn a retry, do NOT pause the queue)
#   5 = one or more criteria are unsatisfiable as written
#       (do NOT burn a retry; route to review for the human)
#
# Exit 5 says the TASK FILE is wrong, not the work: a criterion that no correct
# execution of the task could satisfy cannot be retried into passing, so the
# three attempts that would be spent rediscovering it are skipped and a human
# is asked to fix the criterion. This holds however MANY criteria are bad:
# condition (c) in the prompt lets a second unsatisfiable criterion stand
# beside the first instead of demoting the verdict to FAIL. Reading two false
# premises as a plain failure is what sent six tasks through their full retry
# budget, each one re-proving both premises false on every attempt.
#
# The bar is deliberately high and enforced below in code as well as in the
# prompt: the evaluator must return
# `VERDICT: UNSATISFIABLE` *and* an `## Unsatisfiable Criteria` section, or the
# verdict is read as a plain FAIL. Without that, exit 5 would be a way for an
# agent to dodge work by declaring it impossible.
#
# An empty evaluator response is exit 3, never a FAIL, and this script never
# emits a blank or dangling verdict: a `VERDICT:` line is printed only when the
# evaluator actually produced one.
#
# This file is PROVIDER-NEUTRAL by contract. It must never name a vendor, a
# vendor CLI, a vendor model id, a vendor CLI flag or a vendor JSON field.
# The evaluator's own agent call goes through ai_run / ai_json_text /
# ai_is_auth_failure from providers/<runner>.sh (see providers/CONTRACT.md).

set -euo pipefail

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib.sh"

usage() {
    cat <<'USAGE'
Usage: ai-eval [--runner NAME] [--model ID] TASK_FILE RESULT_FILE [OUTPUT_FILE]

  --runner NAME  Runner that grades this task. Then $AI_RUNNER (set by
                 ai-task), then eval_runner from config, then default_runner.
                 Selectable independently of the task's own ## Runner so a
                 cheap runner can grade an expensive one, or so a different
                 provider can cross-check the one that did the work.
  --model ID     Model the grader uses. Then eval_model from config, then the
                 task's ## Model, then default_model. Graded independently of
                 the task's model because ## Model is a choice about doing the
                 work, not about judging it.

Exit: 0 pass, 1 fail, 2 nothing to grade, 3 inconclusive (auth/empty verdict),
      4 inconclusive (test command timed out),
      5 unsatisfiable acceptance criteria (no retry; needs a human).
USAGE
}

# ── Argument parsing ───────────────────────────────────────────────────────
# --runner may appear before or after the positionals, so ai-task and a human
# can use the same flag order.
RUNNER_FLAG=""
MODEL_FLAG=""
POSITIONAL=()

while [ $# -gt 0 ]; do
    case "$1" in
        --runner)
            RUNNER_FLAG="${2:?--runner requires a runner name}"
            shift 2
            ;;
        --runner=*)
            RUNNER_FLAG="${1#*=}"
            shift
            ;;
        --model)
            MODEL_FLAG="${2:?--model requires a model id}"
            shift 2
            ;;
        --model=*)
            MODEL_FLAG="${1#*=}"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            while [ $# -gt 0 ]; do POSITIONAL+=("$1"); shift; done
            ;;
        --*)
            echo "ai-eval: unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
        *)
            POSITIONAL+=("$1")
            shift
            ;;
    esac
done

TASK_FILE="${POSITIONAL[0]:-}"
RESULT_FILE="${POSITIONAL[1]:-}"
OUTPUT_FILE="${POSITIONAL[2]:-}"

if [ "${#POSITIONAL[@]}" -gt 3 ]; then
    echo "ai-eval: unexpected extra argument: ${POSITIONAL[3]}" >&2
    usage >&2
    exit 2
fi

# Every bad invocation exits 2, not 1: "I could not grade this" must never be
# reported to the caller as "the agent failed", which would burn a retry.
if [ -z "$TASK_FILE" ] || [ -z "$RESULT_FILE" ]; then
    usage >&2
    exit 2
fi

if [ ! -f "$TASK_FILE" ]; then
    echo "ai-eval: task file not found: $TASK_FILE" >&2
    exit 2
fi

if [ ! -f "$RESULT_FILE" ]; then
    echo "ai-eval: result file not found: $RESULT_FILE" >&2
    exit 2
fi

# ── Config ─────────────────────────────────────────────────────────────────
TEST_TIMEOUT_MIN=20
EVAL_TIMEOUT_MIN=45

load_config
TEST_TIMEOUT_MIN=${test_timeout_min:-$TEST_TIMEOUT_MIN}
# No dedicated knob for the evaluator's own run: it is the same kind of headless
# call as the task's, so it inherits task_timeout_min unless told otherwise.
EVAL_TIMEOUT_MIN=${eval_timeout_min:-${task_timeout_min:-$EVAL_TIMEOUT_MIN}}

# Minutes → whole seconds, via awk because bash arithmetic is integer-only.
# A fractional minute is accepted so a throwaway config can cap test commands
# at a few seconds; anything under a second is floored to 1 so `timeout` can
# never be handed 0 (which means "no timeout at all").
min_to_sec() {
    awk -v m="${1:-0}" 'BEGIN { s = int(m * 60); if (s < 1) s = 1; printf "%d\n", s }'
}

TEST_TIMEOUT_SEC=$(min_to_sec "$TEST_TIMEOUT_MIN")

# ── Worktree isolation ─────────────────────────────────────────────────────
# ai-task exports AI_WORKTREE when the task ran in its own worktree (a project
# declaring ## Isolation: worktree). The work under evaluation is THERE, not in
# the project's main working directory, so everything below reads EVAL_TASK: a
# copy of the task file with every reference to the main working directory
# (and to ## Container Path) rewritten to the worktree. ## Test Command then
# runs from inside the worktree, and the grader's own agent call starts there.
#
# Unset, EVAL_TASK is the task file itself and nothing below changes: the
# prompt, the test commands and their working directory are exactly as before.
#
# Set but not a directory is a bad invocation (exit 2, like a missing task
# file): grading the main tree instead would grade work the task never did.
EVAL_TASK="$TASK_FILE"
# The temp copy, kept in its own variable so no cleanup path can ever be
# pointed at the real task file.
EVAL_TASK_TMP=""
WORKTREE="${AI_WORKTREE:-}"
if [ -n "$WORKTREE" ]; then
    if [ ! -d "$WORKTREE" ] || [ -z "${AI_MAIN_WORKDIR:-}" ]; then
        echo "ai-eval: AI_WORKTREE=$WORKTREE is not a directory, or AI_MAIN_WORKDIR is unset" >&2
        exit 2
    fi
    EVAL_TASK_TMP=$(mktemp)
    trap 'rm -f "$EVAL_TASK_TMP"' EXIT
    rewrite_workdir_paths "$AI_MAIN_WORKDIR" "$WORKTREE" "${AI_CONTAINER_PATH:-}" \
        < "$TASK_FILE" > "$EVAL_TASK_TMP" 2>/dev/null
    EVAL_TASK="$EVAL_TASK_TMP"
fi

# Write the verdict report to OUTPUT_FILE when one was named, else to stdout.
emit() {
    if [ -n "$OUTPUT_FILE" ]; then
        printf '%s\n' "$1" > "$OUTPUT_FILE"
    else
        printf '%s\n' "$1"
    fi
}

# ── Test Command ───────────────────────────────────────────────────────────
# Tests run BEFORE the evaluator call: a failing command is a cheap, certain
# FAIL and there is no point paying for a grading run to confirm it.
TEST_PASSED=0

if grep -q "^## Test Command" "$EVAL_TASK"; then
    TEST_TMP=$(mktemp)
    TEST_EXIT=0
    TEST_RAN=0
    TEST_FAILED_CMD=""

    # Test output is human-readable text, not JSON, so merging stderr here is
    # correct and expected. (The separate-streams rule applies to the headless
    # JSON captures further down, which jq has to parse.)
    # In a worktree, each command starts from the worktree, so a relative path
    # or a bare `git diff` sees the task's work. Otherwise the inherited
    # directory, as before.
    run_one_test() {
        if [ -n "$WORKTREE" ]; then
            ( cd "$WORKTREE" && timeout "$TEST_TIMEOUT_SEC" bash -c "$1" ) >> "$TEST_TMP" 2>&1
        else
            timeout "$TEST_TIMEOUT_SEC" bash -c "$1" >> "$TEST_TMP" 2>&1
        fi
    }

    timed_out() {
        emit "$(printf '## Test Results\n\nCommand timed out after %sm (verdict inconclusive):\n```\n%s\n```\n\nPartial output:\n```\n%s\n```' \
            "$TEST_TIMEOUT_MIN" "$1" "$(cat "$TEST_TMP")")"
        rm -f "$TEST_TMP"
        exit 4
    }

    # A trailing backslash continues a command onto the next line: the pieces
    # are assembled into ONE command before running, so `cd x && \` + `make`
    # runs as a single shell where the cd is still in effect. Running the two
    # halves separately would silently change what the task asked for.
    ACC=""
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in '```'*|'~~~'*) continue ;; esac
        if [ "${line%\\}" != "$line" ]; then
            ACC="$ACC${line%\\}"
            continue
        fi
        cmd="$ACC$line"
        ACC=""
        [ -z "${cmd// }" ] && continue
        TEST_RAN=1
        set +e
        run_one_test "$cmd"
        CMD_EXIT=$?
        set -e
        [ $CMD_EXIT -eq 124 ] && timed_out "$cmd"
        if [ $CMD_EXIT -ne 0 ]; then
            TEST_EXIT=$CMD_EXIT
            TEST_FAILED_CMD="$cmd"
            break
        fi
    done < <(awk '/^## Test Command/{found=1; next} found && /^## /{exit} found{print}' "$EVAL_TASK")

    # A section whose last line ends in a backslash leaves the final command in
    # the accumulator with nothing to terminate it; run it rather than drop it.
    if [ $TEST_EXIT -eq 0 ] && [ -n "${ACC// }" ]; then
        TEST_RAN=1
        set +e
        run_one_test "$ACC"
        CMD_EXIT=$?
        set -e
        [ $CMD_EXIT -eq 124 ] && timed_out "$ACC"
        if [ $CMD_EXIT -ne 0 ]; then
            TEST_EXIT=$CMD_EXIT
            TEST_FAILED_CMD="$ACC"
        fi
    fi

    if [ $TEST_EXIT -ne 0 ]; then
        emit "$(printf '## Test Results\n\nCommand failed (exit %s):\n```\n%s\n```\n\nOutput:\n```\n%s\n```\n\nVERDICT: FAIL' \
            "$TEST_EXIT" "$TEST_FAILED_CMD" "$(cat "$TEST_TMP")")"
        rm -f "$TEST_TMP"
        exit 1
    fi

    rm -f "$TEST_TMP"
    [ $TEST_RAN -eq 1 ] && TEST_PASSED=1
fi

# No acceptance criteria: tests alone can carry a PASS; otherwise there is
# nothing to grade and the run stands ungraded (exit 2).
if ! grep -q "^## Acceptance Criteria" "$EVAL_TASK"; then
    if [ $TEST_PASSED -eq 1 ]; then
        exit 0
    fi
    exit 2
fi

# ── Runner ─────────────────────────────────────────────────────────────────
# The evaluator's runner is chosen independently of the task's:
#
#   --runner  →  AI_RUNNER  →  eval_runner  →  default_runner
#
# AI_RUNNER is exported by ai-task and names the runner that actually EXECUTED
# the task; it sits above eval_runner so an explicit caller still wins. ai-task
# itself passes --runner, so in the automated path this variable is the record
# of who did the work rather than the choice of who grades it.
#
# `eval_runner` is what makes cross-provider verification possible: the value of
# a second opinion is that its failure modes are independent, and a grader that
# shares the executor's training shares its blind spots. There is deliberately
# no logic here that adapts the prompt to a cross-runner pairing — the prompt
# grades a report against acceptance criteria, which is provider-neutral.
RUNNER="$RUNNER_FLAG"
[ -n "$RUNNER" ] || RUNNER="${AI_RUNNER:-}"
[ -n "$RUNNER" ] || RUNNER="${eval_runner:-}"
[ -n "$RUNNER" ] || RUNNER="${default_runner:-}"

# A runner that cannot be loaded is a configuration fault, not a failed task,
# so it exits 3 (inconclusive) rather than 1. Burning retries on every task in
# the queue because an adapter is missing is the worse failure mode.
if [ -z "$RUNNER" ]; then
    echo "ai-eval: no runner (pass --runner, set AI_RUNNER, or set eval_runner / default_runner in config)" >&2
    exit 3
fi
if ! load_provider "$RUNNER"; then
    exit 3
fi

# ── Model ──────────────────────────────────────────────────────────────────
#   --model  →  eval_model  →  the task's ## Model  →  default_model
#
# eval_model sits ABOVE the task's ## Model on purpose. `## Model` is a
# statement about what it takes to DO the work; grading is a different and
# usually smaller job (read the criteria, read the report, weigh the test
# output), so inheriting the executor's model silently priced every verdict at
# the cost of the work. The task's value is still honoured when neither the
# flag nor the config key is set, so nothing changes for a tree that sets
# neither.
#
# Whatever the alias table maps empty to is the last word: providers genuinely
# differ on what "unset" means and this must not be second-guessed.
MODEL_RAW="$MODEL_FLAG"
[ -n "$MODEL_RAW" ] || MODEL_RAW="${eval_model:-}"
[ -n "$MODEL_RAW" ] || MODEL_RAW=$(model_from_task "$TASK_FILE")
[ -n "$MODEL_RAW" ] || MODEL_RAW="${default_model:-}"
MODEL_ID=$(ai_model_alias "$MODEL_RAW")

PROMPT_TMP=$(mktemp)
JSON_TMP=$(mktemp)
ERR_TMP=$(mktemp)
cleanup() { rm -f "$PROMPT_TMP" "$JSON_TMP" "$ERR_TMP" ${EVAL_TASK_TMP:+"$EVAL_TASK_TMP"}; }
trap cleanup EXIT

{
    cat <<'PREAMBLE'
You are a skeptical evaluator reviewing the output of an autonomous agent. Assess whether the task was completed correctly against its acceptance criteria.

Rules:
- Be critical. Do not give the benefit of the doubt.
- Grade every criterion AS WRITTEN, not as you would charitably reinterpret it. If a criterion names a specific file, path, command, service, table, flag or value, that exact thing is what had to be used. An agent that quietly substituted something equivalent-looking and then reported success has FAILED that criterion, however well the substitute works.
- If a criterion cannot be verified from the result, mark it FAIL.
- A criterion that is demonstrably FALSE ABOUT THE WORLD is a different thing from one that is unmet or unverified. That case, and only that case, has its own verdict; see UNSATISFIABLE below. It is an exception to neither of the two rules above, which still apply in full to every other criterion.
- Do not praise — only report problems.
- You may use tools (read files, run shell commands) to verify criteria when the result report alone is insufficient.

UNSATISFIABLE — use this verdict ONLY when ALL THREE of the following hold:
  (a) the result file demonstrates that the criterion's premise is FALSE, by showing a command AND its output, rather than merely asserting that the criterion is unreasonable, unfair, badly worded or hard;
  (b) no correct execution of this task could have satisfied the criterion — it is impossible, not merely hard, slow, expensive, or left unverified;
  (c) every OTHER acceptance criterion either PASSES, or independently satisfies (a) and (b) in its own right.
More than one criterion in the same task can be unsatisfiable, and when that happens the verdict is still UNSATISFIABLE. A task file carrying two false premises is more broken than one carrying a single false premise, not less, and grading it FAIL spends every retry rediscovering both. What (c) forbids is mixing this verdict with work that is merely unfinished, not finding a second bad criterion. Each criterion you grade UNSATISFIABLE needs its own command and its own output in ## Unsatisfiable Criteria: evidence is per criterion and one argument may never cover several, so claiming N of them costs N demonstrations.
A criterion the agent simply did not check is FAIL, not UNSATISFIABLE. Incomplete or partial work plus an impossible criterion is FAIL, not UNSATISFIABLE. An assertion that a criterion is impossible, with no command and no output in the result file to back it, is FAIL. Where you are unsure, the answer is FAIL.

Output format:
1. Grade each acceptance criterion as: "- [PASS/FAIL/UNSATISFIABLE] criterion: one-line reason"
2. A "## Issues" section listing specific problems to fix (omit section entirely if all PASS).
3. When, and only when, your verdict is UNSATISFIABLE: an "## Unsatisfiable Criteria" section with ONE ENTRY PER offending criterion, each naming that criterion verbatim and quoting the evidence from the result file — the command and its output — that disproves that particular one. This section is what makes the outcome auditable by a human, so a UNSATISFIABLE verdict without it is read as a plain FAIL.
4. End your response with exactly one of these three lines:
   VERDICT: PASS
   VERDICT: FAIL
   VERDICT: UNSATISFIABLE

---
## TASK

PREAMBLE
    cat "$EVAL_TASK"
    project_instructions "$(project_from_task "$TASK_FILE")"
    # Isolated tasks only: a shared task's prompt stays byte-identical.
    if [ -n "$WORKTREE" ]; then
        printf '\nISOLATED WORKTREE: this task ran in its own git worktree, %s, and the work to evaluate is there, uncommitted. Verify every criterion in that directory, never in the main working directory %s, which does not contain this work. Paths in the task above have already been rewritten to point at the worktree.\n' \
            "$WORKTREE" "$AI_MAIN_WORKDIR"
    fi
    printf "\n---\n## RESULT\n\n"
    cat "$RESULT_FILE"
} > "$PROMPT_TMP"

# The provider owns the timeout wrapper and returns the CLI status verbatim.
# stdout and stderr land in two SEPARATE files: merged stderr prepends warnings
# to the JSON, parsing then fails, and the verdict silently comes out empty.
set +e
ai_run "$(cat "$PROMPT_TMP")" \
    "$MODEL_ID" \
    "$WORKTREE" \
    "$(min_to_sec "$EVAL_TIMEOUT_MIN")" \
    "$JSON_TMP" \
    "$ERR_TMP"
RUN_STATUS=$?
set -e

EVAL_TEXT=$(ai_json_text "$JSON_TMP" || true)

# ── Inconclusive ───────────────────────────────────────────────────────────
# Checked BEFORE anything is emitted. An auth failure means no grading happened
# and an empty response means no verdict was reached; neither is a FAIL, and
# neither may leave a verdict line behind. Any partial text is reported with
# its verdict lines stripped, so a half-finished run can still be read without
# the caller's grep mistaking it for a decision.
if ai_is_auth_failure "$JSON_TMP" || ai_is_auth_failure "$ERR_TMP" || [ -z "$EVAL_TEXT" ]; then
    INCONCLUSIVE=$(printf '## Evaluation Inconclusive\n\nThe evaluator produced no usable verdict (authentication failure or empty response). No retry burned.')
    if [ -n "$EVAL_TEXT" ]; then
        INCONCLUSIVE=$(printf '%s\n\nPartial evaluator output:\n```\n%s\n```' \
            "$INCONCLUSIVE" "$(printf '%s\n' "$EVAL_TEXT" | grep -v '^VERDICT:' || true)")
    fi
    emit "$INCONCLUSIVE"
    exit 3
fi

emit "$EVAL_TEXT"

if [ "$RUN_STATUS" -ne 0 ]; then
    exit 1
fi

if printf '%s\n' "$EVAL_TEXT" | grep -q "^VERDICT: PASS$"; then
    exit 0
fi

# The auditable section is required HERE, in code, not only asked for in the
# prompt: exit 5 skips the whole retry loop, so a verdict a human cannot check
# must not be able to reach it. An UNSATISFIABLE with no
# `## Unsatisfiable Criteria` section falls through to the FAIL below, which is
# the safe direction — it costs one retry, where the reverse mistake costs the
# task its grading altogether.
if printf '%s\n' "$EVAL_TEXT" | grep -q "^VERDICT: UNSATISFIABLE$" \
   && printf '%s\n' "$EVAL_TEXT" | grep -q "^## Unsatisfiable Criteria"; then
    exit 5
fi

exit 1
