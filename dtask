#!/bin/bash
# dtask: dashboard view of the ai-utils pipeline (~/tasks/, all runners).
#
# Read-only. Never calls an agent, never moves a file, never writes into the
# tree: it only reads $TASKS_DIR (via lib.sh) and $SCRIPT_DIR/providers/*.sh.
#
# Ported from the reference dashboard that already covered what four separate
# per-provider dashboards (dtask, ltask, vtask, mtask) used to split up. This
# single script replaces all four for the unified tree. Runner names are never
# hardcoded here: they come from config (default_runner) and from
# providers/*.sh / .auth-cooldown-* file names at runtime.
#
# Usage:
#   dtask                  Show dashboard once
#   dtask -w               Scrollable live view, refreshed every 30 seconds

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
PROVIDERS_DIR="$SCRIPT_DIR/providers"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib.sh"

if [ "${1:-}" = "-w" ]; then
    if [ -t 0 ] && [ -t 1 ]; then
        exec python3 "$SCRIPT_DIR/dashboard_view.py" "$(realpath "$0")"
    fi
    # Redirected output is a single snapshot, with no terminal controls.
fi

AUTH_COOLDOWN_MIN=30
load_config
AUTH_COOLDOWN_MIN=${auth_cooldown_min:-$AUTH_COOLDOWN_MIN}

# ── Colors ──────────────────────────────────────────────────────
if [ "${NO_COLOR:-}" ]; then
    BOLD="" RED="" GREEN="" YELLOW="" BLUE="" CYAN="" DIM="" RESET=""
else
    BOLD=$(tput bold 2>/dev/null || echo "")
    RED=$(tput setaf 1 2>/dev/null || echo "")
    GREEN=$(tput setaf 2 2>/dev/null || echo "")
    YELLOW=$(tput setaf 3 2>/dev/null || echo "")
    BLUE=$(tput setaf 4 2>/dev/null || echo "")
    CYAN=$(tput setaf 6 2>/dev/null || echo "")
    DIM=$(tput dim 2>/dev/null || tput setaf 8 2>/dev/null || echo "")
    RESET=$(tput sgr0 2>/dev/null || echo "")
fi

# ── Helpers ─────────────────────────────────────────────────────

# Count .md task files in a directory (ignores sidecars: .state, .raw, .log).
_count() {
    local dir="$1" n
    [ -d "$dir" ] || { echo 0; return; }
    n=$(find "$dir" -maxdepth 1 -type f -name "*.md" | wc -l)
    echo "${n// /}"
}

# List basenames (strip .md) of .md task files in a directory
_list() {
    local dir="$1"
    [ -d "$dir" ] || return
    find "$dir" -maxdepth 1 -type f -name "*.md" -printf "%f\n" | sed 's/\.md$//' | sort
}

# Strip YYYY-MM-DD_ and optional HH-MM_ prefixes for display
_display() {
    echo "$1" | sed 's/^[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}_[0-9]\{2\}-[0-9]\{2\}_//' \
              | sed 's/^[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}_//'
}

# Elapsed time from file mtime
_elapsed() {
    local file="$1"
    local now mtime diff
    now=$(date +%s)
    mtime=$(stat -c %Y "$file" 2>/dev/null || echo "$now")
    diff=$((now - mtime))
    if   [ "$diff" -lt 60 ];   then echo "${diff}s"
    elif [ "$diff" -lt 3600 ]; then echo "$((diff/60))m"
    else echo "$((diff/3600))h$((diff%3600/60))m"
    fi
}

# tmux session name used by ai-task for one runner/task pair.
_session_task() {
    printf '%s' "ai-${1}-${2}" | tr -c 'A-Za-z0-9_-' '-' | cut -c1-50
}

# tmux session name used by ai-brief for one runner/brief pair.
_session_brief() {
    printf '%s' "ai-brief-${1}-${2}" | tr -c 'A-Za-z0-9_-' '-' | cut -c1-50
}

# Runner names this tree knows about: every providers/<runner>.sh on disk,
# plus the suffix of any .auth-cooldown-<runner> marker actually present, so a
# marker never goes unreported just because its provider file was removed.
_known_runners() {
    local f name
    declare -A seen=()
    if [ -d "$PROVIDERS_DIR" ]; then
        for f in "$PROVIDERS_DIR"/*.sh; do
            [ -f "$f" ] || continue
            name=$(basename "$f" .sh)
            seen[$name]=1
        done
    fi
    for f in "$TASKS_DIR"/.auth-cooldown-*; do
        [ -f "$f" ] || continue
        name="${f##*/.auth-cooldown-}"
        [ -n "$name" ] && seen[$name]=1
    done
    printf '%s\n' "${!seen[@]}" | sort
}

# Resolve a task file's runner, falling back to default_runner (never blank,
# never "unknown"): runner_from_task already does this, this just names the
# rare case where neither is configured.
_runner_of() {
    runner_from_task "$1" 2>/dev/null || echo "unconfigured"
}

# Resolve the runner for a DONE.md entry, given the **Result:** path it names.
#
# That path is the RESULT file, which carries the runner as a bold field
# (`**Runner:** x`), NOT as a `## Runner` heading. Handing it straight to
# runner_from_task therefore always finds nothing and falls back to
# default_runner, so every archived entry rendered as the default runner
# whatever it actually ran on. Read the archived task file instead: ai-task
# stores it beside the result as `<base>.task.md`, and that one does carry a
# real `## Runner` section.
#
# Order matters: the `.task.md` companion is ground truth, the result file's
# bold field is the fallback for an entry whose task file has been moved away,
# and only then do we resolve to the configured default.
_runner_of_result() {
    local result="${1:-}" task_file bold
    [ -n "$result" ] || { echo "unconfigured"; return 0; }

    task_file="${result%.md}.task.md"
    if [ -r "$task_file" ]; then
        runner_from_task "$task_file" 2>/dev/null && return 0
    fi

    if [ -r "$result" ]; then
        bold=$(awk '/^\*\*Runner:\*\*/ {sub(/^\*\*Runner:\*\* +/, ""); print; exit}' \
            "$result" 2>/dev/null | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
        [ -n "$bold" ] && { printf '%s\n' "$bold"; return 0; }
    fi

    _runner_of "$result"
}

# Print a section header
_section() {
    printf '\n%s%s%s\n' "${BOLD}${CYAN}" "$1" "$RESET"
}

# Print a separator line
_sep() {
    printf '%s%s%s\n' "$DIM" "────────────────────────────────────────────────────────────" "$RESET"
}

# Format a pipeline stage: dimmed if 0, yellow if warn+count>0, else normal
_stage() {
    local label="$1" count="$2" warn="${3:-}"
    if [ "$count" -eq 0 ]; then
        printf '%s%s(%d)%s' "$DIM" "$label" "$count" "$RESET"
    elif [ -n "$warn" ]; then
        printf '%s%s%s(%s%d%s)' "$BOLD" "$label" "$RESET" "${YELLOW}" "$count" "$RESET"
    else
        printf '%s%s%s(%d)' "$BOLD" "$label" "$RESET" "$count"
    fi
}

# True if the given runner's cooldown marker is still inside the window.
_cooldown_active() {
    local marker
    marker=$(cooldown_path "$1") || return 1
    [ -f "$marker" ] || return 1
    find "$marker" -mmin -"$AUTH_COOLDOWN_MIN" 2>/dev/null | grep -q .
}

_cooldown_left() {
    local marker now mtime elapsed left
    marker=$(cooldown_path "$1") || { echo 0; return; }
    now=$(date +%s)
    mtime=$(stat -c %Y "$marker" 2>/dev/null || echo "$now")
    elapsed=$(( (now - mtime) / 60 ))
    left=$((AUTH_COOLDOWN_MIN - elapsed))
    [ "$left" -lt 0 ] && left=0
    echo "$left"
}

# ── Counts ──────────────────────────────────────────────────────
n_briefs=$(_count "$BRIEFS_DIR")
n_brev=$(_count "$BACKLOG_REVIEW_DIR")
n_inbox=$(_count "$INBOX")
n_run=$(_count "$RUN_DIR")
n_review=$(_count "$REVIEW_DIR")

# ── Blocked chains ──────────────────────────────────────────────
# A task whose ## Depends-on can never be satisfied waits in inbox/ forever and
# is otherwise invisible: select_candidate skips it silently, so a queue that
# still holds other runnable work never mentions it once. Only DEAD blocks are
# counted here (dep sitting in review/, or a slug that exists nowhere); a dep
# that is merely still queued is ordinary waiting and resolves on its own.
blocked_dead=""
n_blocked=0
while IFS=$'\t' read -r b_task b_dep b_loc; do
    [ -n "$b_task" ] || continue
    case "$b_loc" in
        review|missing) ;;
        *) continue ;;
    esac
    blocked_dead="${blocked_dead}${b_task}"$'\t'"${b_dep}"$'\t'"${b_loc}"$'\n'
    n_blocked=$((n_blocked + 1))
done < <(blocked_inbox_tasks)

# ── Waiting on a ## Precondition ────────────────────────────────
# Status files are written by ai-task's pre-claim pass. dtask only READS them
# and never runs a precondition itself: a check may ssh to another host, and
# opening the dashboard must not. A file whose task has left inbox/ is stale
# (ai-task removes it on its next sweep) and is ignored here.
precond_rows=""
n_precond=0
if [ -d "$PRECONDITION_DIR" ]; then
    for p_file in "$PRECONDITION_DIR"/*; do
        [ -f "$p_file" ] || continue
        p_task=$(basename "$p_file")
        [ -f "$INBOX/${p_task}.md" ] || continue
        p_since=$(sed -n 's/^since: //p' "$p_file" | head -n 1)
        p_exit=$(sed -n 's/^exit: //p' "$p_file" | head -n 1)
        precond_rows="${precond_rows}${p_task}"$'\x1f'"${p_since}"$'\x1f'"${p_exit}"$'\n'
        n_precond=$((n_precond + 1))
    done
fi

# ── Worktrees (## Isolation: worktree projects only) ─────────────
# Scanned here, rendered further down, because a branch to merge or a worktree
# holding orphaned changes also belongs in NEEDS ATTENTION. Nothing is
# collected unless some project opts in, so the dashboard of a tree with none
# is unchanged. One row per ai/<key> branch (or worktree left without one);
# the action is worktree_action in lib.sh, and the text says in plain words
# what to do. Merged branches fold into one row past WT_DONE_SHOWN, since the
# pipeline never deletes a branch and they only accumulate.
#
# Read-only like the rest of dtask: GIT_OPTIONAL_LOCKS=0 stops `git status`
# from refreshing the index, which is a write into the repository.
# Row fields are joined by the unit separator, not a tab: a tab is IFS
# whitespace, so `read` would merge the empty color field of a NO_COLOR run
# with its neighbour and shift every field after it.
US=$'\x1f'
WT_DONE_SHOWN=3
wt_rows=()        # rank, project, name, icon, color, text; joined by $US
wt_attention=()   # project \t name \t short reason, for NEEDS ATTENTION
wt_w_proj=0 wt_w_name=0
declare -A wt_seen wt_live wt_review_slugs
wt_any=0
if [ -d "$PROJECTS_DIR" ]; then
    for wt_pf in "$PROJECTS_DIR"/*.md; do
        [ -f "$wt_pf" ] || continue
        [ "$(project_isolation "$(basename "$wt_pf" .md)" 2>/dev/null)" = worktree ] && { wt_any=1; break; }
    done
fi

# A brief's name without what the reader already knows: the ai/ prefix, the
# project it sits under, and the -brief suffix every brief file carries.
_wt_name() {
    local wt_key="$1" wt_proj="$2"
    wt_key="${wt_key#"$wt_proj"-}"
    wt_key="${wt_key%-brief}"
    printf '%s' "${wt_key:-$1}"
}

if [ "$wt_any" -eq 1 ]; then
    # Task keys still queued or running, and the review/ slugs, scanned once.
    for wt_dir in "$INBOX" "$RUN_DIR" "$REVIEW_DIR"; do
        [ -d "$wt_dir" ] || continue
        for wt_f in "$wt_dir"/*.md; do
            [ -f "$wt_f" ] || continue
            wt_k=$(worktree_key "$wt_f" 2>/dev/null) || continue
            if [ "$wt_dir" = "$REVIEW_DIR" ]; then
                wt_review_slugs[$wt_k]+="$(task_slug_from_name "$wt_f") "
            else
                wt_live[$wt_k]=$(( ${wt_live[$wt_k]:-0} + 1 ))
            fi
        done
    done

    for wt_pf in "$PROJECTS_DIR"/*.md; do
        [ -f "$wt_pf" ] || continue
        wt_proj=$(basename "$wt_pf" .md)
        [ "$(project_isolation "$wt_proj" 2>/dev/null)" = worktree ] || continue
        wt_wd=$(project_working_dir "$wt_proj") || continue
        wt_top=$(git -C "$wt_wd" rev-parse --show-toplevel 2>/dev/null) || continue
        [ -z "${wt_seen[$wt_top]:-}" ] || continue
        wt_seen[$wt_top]=1
        wt_base=$(project_field "$wt_proj" 'Base Branch')
        wt_base="${wt_base:-HEAD}"

        wt_keys=$(
            GIT_OPTIONAL_LOCKS=0 git -C "$wt_top" for-each-ref --format='%(refname:short)' \
                refs/heads/ai/ 2>/dev/null | sed 's|^ai/||'
            for wt_d in "$wt_top/$WORKTREE_DIRNAME"/*/; do
                [ -d "$wt_d" ] && basename "$wt_d"
            done
        )
        wt_done_rows=()
        while IFS= read -r wt_key; do
            [ -n "$wt_key" ] || continue
            wt_slugs="${wt_review_slugs[$wt_key]:-}"
            wt_slugs="${wt_slugs% }"
            wt_n_review=0
            [ -n "$wt_slugs" ] && wt_n_review=$(wc -w <<< "$wt_slugs")
            wt_n_live=${wt_live[$wt_key]:-0}
            # The base ai-task recorded for this branch (a brief may name its
            # own), else the project's.
            wt_kbase=$(branch_base "$wt_top" "$wt_key" "$wt_base")
            wt_action=$(GIT_OPTIONAL_LOCKS=0 worktree_action "$wt_top" "$wt_key" "$wt_kbase" "$wt_n_live" "$wt_n_review")
            wt_name=$(_wt_name "$wt_key" "$wt_proj")
            wt_path="${wt_top/#"$HOME"/\~}/$WORKTREE_DIRNAME/$wt_key"
            case "$wt_action" in
                fix)
                    wt_rank=1 wt_icon="✗" wt_color="$RED"
                    wt_text="${wt_slugs// /, } failed review: fix it, then ai-task --unblock ${wt_slugs%% *}" ;;
                commit)
                    wt_rank=2 wt_icon="⚠" wt_color="$YELLOW"
                    wt_text="changes left uncommitted, no task left: commit or discard in $wt_path"
                    wt_attention+=("$wt_proj"$'\t'"$wt_name"$'\t'"uncommitted changes, no task left") ;;
                merge)
                    wt_rank=3 wt_icon="⇢" wt_color="$YELLOW"
                    wt_text="ready to merge into $wt_kbase: git merge ai/$wt_key"
                    wt_attention+=("$wt_proj"$'\t'"$wt_name"$'\t'"ready to merge into $wt_kbase") ;;
                prune)
                    wt_rank=4 wt_icon="·" wt_color="$DIM"
                    wt_text="finished, worktree removed by the next sweep" ;;
                wait)
                    wt_rank=5 wt_icon="⏳" wt_color="$DIM"
                    if [ "$wt_n_live" -eq 1 ]; then
                        wt_text="1 task still to run, nothing to do yet"
                    else
                        wt_text="$wt_n_live tasks still to run, nothing to do yet"
                    fi ;;
                *)
                    wt_rank=6 wt_icon="✓" wt_color="$DIM"
                    wt_text="merged, can be deleted: git branch -d ai/$wt_key"
                    wt_done_rows+=("$wt_rank$US$wt_proj$US$wt_name$US$wt_icon$US$wt_color$US$wt_text")
                    continue ;;
            esac
            wt_rows+=("$wt_rank$US$wt_proj$US$wt_name$US$wt_icon$US$wt_color$US$wt_text")
        done < <(printf '%s\n' "$wt_keys" | sort -u)
        if [ "${#wt_done_rows[@]}" -gt "$WT_DONE_SHOWN" ]; then
            wt_rows+=("6$US$wt_proj$US+${#wt_done_rows[@]} merged branches$US✓$US$DIM${US}can be deleted: git branch -d ai/…")
        elif [ "${#wt_done_rows[@]}" -gt 0 ]; then
            wt_rows+=("${wt_done_rows[@]}")
        fi
    done
    for wt_r in "${wt_rows[@]}"; do
        IFS="$US" read -r _ wt_p wt_n _ <<< "$wt_r"
        [ "${#wt_p}" -gt "$wt_w_proj" ] && wt_w_proj=${#wt_p}
        [ "${#wt_n}" -gt "$wt_w_name" ] && wt_w_name=${#wt_n}
    done
fi

# ── Agents (scanned here, rendered at the end) ───────────────────
# What each PUBLISHED routine is doing, one line each, most urgent first: will
# not run (the published file has a schedule or permission ai-scheduled
# rejects), overdue (no run for over two periods, which in practice means the
# engine is not in cron), found something in the last 7 days, waiting for its
# first run, quiet. Routines defined but not published fold into one line.
# The configuration (kind, schedule, permission) is ai-agent's listing.
#
# Everything comes from state ai-scheduled already keeps: the <slug>.run stamp
# and the memory ledger (agent_memory_summary). The ledger records conclusive
# runs only, so a failing routine shows as overdue, not as failed.
#
# Strictly read-only, like the rest of this script, and prints NOTHING AT ALL,
# not even the header, when no routine is defined: a tree with no agents must
# render exactly the dashboard it rendered before this section existed.
AGENTS_DIR="$(agents_dir)"

# Routine definition files, as absolute paths: agents/<agent>/routines/<slug>.md
_routine_files() {
    [ -d "$AGENTS_DIR" ] || return
    find "$AGENTS_DIR" -mindepth 3 -maxdepth 3 -type f -path '*/routines/*.md' \
        2>/dev/null | sort
}

# Seconds as a short age: 45m, 30h, 25 days.
_ago() {
    local s="$1"
    if   [ "$s" -lt 3600 ];   then echo "$(( s / 60 ))m"
    elif [ "$s" -lt 172800 ]; then echo "$(( s / 3600 ))h"
    else echo "$(( s / 86400 )) days"
    fi
}

# A ledger outcome ('messages=2, briefs=a,b, report=x.md') in plain words.
_ag_outcome() {
    local part out="" item
    while IFS= read -r part; do
        case "$part" in
            messages=1)  item="1 message" ;;
            messages=*)  item="${part#messages=} messages" ;;
            briefs=*)    item="brief ${part#briefs=}"; item="${item//,/, }" ;;
            report=*)    item="report" ;;
            stub=*)      item="suggestion ${part#stub=}" ;;
            stubs=1)     item="1 suggestion" ;;
            stubs=*)     item="${part#stubs=} suggestions" ;;
            *)           continue ;;
        esac
        out="${out:+$out, }$item"
    done < <(printf '%s\n' "$1" | sed 's/, /\n/g')
    printf '%s' "$out"
}

_ag_label() {
    case "$1" in
        every:*h) echo "every ${1#every:}" ;;
        weekly*)  echo "weekly" ;;
        *)        echo "$1" ;;
    esac
}

ag_rows=()        # rank, slug, agent, icon, color, text, stats; joined by $US
ag_attention=()   # slug \t agent \t short reason, for NEEDS ATTENTION
ag_any=0 ag_unpub=0 ag_w_slug=0 ag_w_agent=0
_agent_routines=$(_routine_files)
if [ -n "$_agent_routines" ]; then
    ag_any=1
    ag_now=$(date +%s)
    while IFS= read -r rfile; do
        [ -f "$rfile" ] || continue
        rslug=$(basename "$rfile" .md)
        # <agents_dir>/<agent>/routines/<slug>.md → <agent>
        ragent=$(basename "$(dirname "$(dirname "$rfile")")")
        # What runs is the PUBLISHED copy, so that is the one judged.
        ag_pf="$SCHEDULED_DIR/$rslug.md"
        if [ ! -f "$ag_pf" ]; then
            ag_unpub=$((ag_unpub + 1))
            continue
        fi
        ag_sched=$(field_from_task Schedule "$ag_pf" | awk 'NR == 1 {print $1}')
        ag_stats=""
        IFS=$'\t' read -r ag_runs ag_sigs ag_capped ag_lt ag_lo \
            < <(agent_memory_summary "$rslug" 7) || true
        if [ "${ag_runs:-0}" -gt 0 ]; then
            ag_plus=""; [ "${ag_capped:-0}" -eq 1 ] && ag_plus="+"
            ag_stats="7d: ${ag_runs}${ag_plus} runs, ${ag_sigs} signals"
        fi
        ag_last=""
        [ -f "$SCHED_STATE_DIR/$rslug.run" ] \
            && ag_last=$(head -n1 "$SCHED_STATE_DIR/$rslug.run" 2>/dev/null | tr -dc '0-9')

        if ! ag_period=$(schedule_period_sec "$ag_sched"); then
            ag_rank=1 ag_icon="✗" ag_color="$RED"
            ag_text="will not run: invalid schedule '${ag_sched}'"
            ag_attention+=("$rslug"$'\t'"$ragent"$'\t'"will not run, invalid schedule")
        elif ! permission_from_job "$ag_pf" >/dev/null 2>&1; then
            ag_rank=1 ag_icon="✗" ag_color="$RED"
            ag_text="will not run: unrecognised permission '$(field_from_task Permission "$ag_pf" | awk 'NR == 1 {print $1}')'"
            ag_attention+=("$rslug"$'\t'"$ragent"$'\t'"will not run, unrecognised permission")
        else
            # Two periods plus an hour of slack for the sweep interval.
            ag_grace=$(( 2 * ag_period + 3600 ))
            ag_lt_s=""
            [ -n "${ag_lt:-}" ] && ag_lt_s=$(date -d "$ag_lt" +%s 2>/dev/null || true)
            if [ -z "$ag_last" ]; then
                ag_pub_s=$(stat -c %Y "$ag_pf" 2>/dev/null || echo "$ag_now")
                if [ $(( ag_now - ag_pub_s )) -gt "$ag_grace" ]; then
                    ag_rank=2 ag_icon="⚠" ag_color="$YELLOW"
                    ag_text="overdue: runs $(_ag_label "$ag_sched"), published $(_ago $(( ag_now - ag_pub_s ))) ago and never run (is ai-scheduled in cron?)"
                    ag_attention+=("$rslug"$'\t'"$ragent"$'\t'"overdue, never run")
                else
                    ag_rank=4 ag_icon="⏳" ag_color="$DIM"
                    ag_text="published, waiting for its first run"
                fi
            elif [ $(( ag_now - ag_last )) -gt "$ag_grace" ]; then
                ag_rank=2 ag_icon="⚠" ag_color="$YELLOW"
                ag_text="overdue: runs $(_ag_label "$ag_sched"), last run $(_ago $(( ag_now - ag_last ))) ago (is ai-scheduled in cron?)"
                ag_attention+=("$rslug"$'\t'"$ragent"$'\t'"overdue")
            elif [ -n "$ag_lt_s" ]; then
                ag_rank=3 ag_icon="✉" ag_color="$GREEN"
                ag_what=$(_ag_outcome "${ag_lo:-}")
                ag_text="found something $(_ago $(( ag_now - ag_lt_s ))) ago${ag_what:+: $ag_what}"
            else
                ag_rank=5 ag_icon="✓" ag_color="$DIM"
                ag_text="nothing to report (ran $(_ago $(( ag_now - ag_last ))) ago)"
            fi
        fi
        ag_rows+=("$ag_rank$US$rslug$US$ragent$US$ag_icon$US$ag_color$US$ag_text$US$ag_stats")
        [ "${#rslug}" -gt "$ag_w_slug" ] && ag_w_slug=${#rslug}
        [ "${#ragent}" -gt "$ag_w_agent" ] && ag_w_agent=${#ragent}
    done <<< "$_agent_routines"
fi

total_attention=$((n_brev + n_review + n_blocked + n_precond + ${#wt_attention[@]} + ${#ag_attention[@]}))

# ── Today's stats from DONE.md ──────────────────────────────────
today=$(date '+%Y-%m-%d')
n_done=0; n_retry=0; n_failed=0; n_needs_review=0; n_deferred=0

if [ -f "$LOG" ]; then
    today_statuses=$(awk -v d="$today" '
        /^## / { in_today = ($2 == d) }
        in_today && /^\*\*Status:\*\*/ { print }
    ' "$LOG")
    n_done=$(echo "$today_statuses" | grep -c "completed" || true)
    n_retry=$(echo "$today_statuses" | grep -c "requeued" || true)
    n_failed=$(echo "$today_statuses" | grep -c "FAILED" || true)
    n_needs_review=$(echo "$today_statuses" | grep -c "NEEDS REVIEW" || true)
    n_deferred=$(echo "$today_statuses" | grep -c "DEFERRED" || true)
fi

# ── Header ──────────────────────────────────────────────────────
printf '%s  ai-dash%s  ·  %s\n' "${BOLD}${BLUE}" "$RESET" "$(date '+%a %b %-d, %H:%M')"
_sep

# ── Per-runner auth cooldown ─────────────────────────────────────
cooldown_any=0
while IFS= read -r r; do
    [ -z "$r" ] && continue
    if _cooldown_active "$r"; then
        cooldown_any=1
        printf '%s  ⚠  AUTH COOLDOWN (%s)  %s%sm remaining%s  ·  unattended launches paused for this runner\n' \
            "${BOLD}${RED}" "$r" "$RESET" "$(_cooldown_left "$r")" "$DIM"
    fi
done < <(_known_runners)
[ "$cooldown_any" -eq 1 ] && _sep

# ── Needs Attention ─────────────────────────────────────────────
_section "⚑  NEEDS ATTENTION"

if [ "$total_attention" -eq 0 ]; then
    printf '  %s✓ Nothing needs your attention%s\n' "$GREEN" "$RESET"
else
    printf '  %s%d item(s) require your input%s\n\n' "${BOLD}${YELLOW}" "$total_attention" "$RESET"

    while IFS= read -r name; do
        [ -z "$name" ] && continue
        runner=$(_runner_of "$BACKLOG_REVIEW_DIR/${name}.md")
        printf '  %s●%s %-40s  %s[%s]%s  %s(backlog for review)%s\n' \
            "$YELLOW" "$RESET" "$(_display "$name")" "$CYAN" "$runner" "$RESET" "$DIM" "$RESET"
    done < <(_list "$BACKLOG_REVIEW_DIR")

    while IFS= read -r name; do
        [ -z "$name" ] && continue
        runner=$(_runner_of "$REVIEW_DIR/${name}.md")
        # ai-propose output, when there is some. Files without .md, so no list
        # or count in this script ever takes them for tasks.
        hint=""
        if [ -f "$REVIEW_DIR/${name}.proposal.json" ]; then
            hint=", fix proposed: ai-propose --apply ${name#*_}"
        elif [ -f "$REVIEW_DIR/${name}.proposal" ]; then
            hint=", see ${name}.proposal"
        fi
        printf '  %s●%s %-40s  %s[%s]%s  %s(failed, needs review%s)%s\n' \
            "$RED" "$RESET" "$(_display "$name")" "$CYAN" "$runner" "$RESET" "$DIM" "$hint" "$RESET"
    done < <(_list "$REVIEW_DIR")

    # Dead dependency chains. These are NOT in review/ themselves: they sit in
    # inbox/ looking perfectly healthy, and nothing else in this dashboard
    # would ever mention them. Fixing the parent is what clears them.
    while IFS=$'\t' read -r b_task b_dep b_loc; do
        [ -n "$b_task" ] || continue
        runner=$(_runner_of "$INBOX/${b_task}.md")
        if [ "$b_loc" = "review" ]; then
            why="dep '$b_dep' is in review/"
        else
            why="dep '$b_dep' is nowhere in the pipeline"
        fi
        printf '  %s⊘%s %-40s  %s[%s]%s  %s(blocked: %s)%s\n' \
            "$RED" "$RESET" "$(_display "$b_task")" "$CYAN" "$runner" "$RESET" \
            "$DIM" "$why" "$RESET"
    done < <(printf '%s' "$blocked_dead")

    # Waiting on something only the human can supply. The task is healthy
    # and burns nothing while it waits; the status file says what failed.
    while IFS="$US" read -r p_task p_since p_exit; do
        [ -n "$p_task" ] || continue
        runner=$(_runner_of "$INBOX/${p_task}.md")
        printf '  %s⏸%s %-40s  %s[%s]%s  %s(waiting: precondition since %s, exit %s, see .precondition/%s)%s\n' \
            "$YELLOW" "$RESET" "$(_display "$p_task")" "$CYAN" "$runner" "$RESET" \
            "$DIM" "${p_since:-?}" "${p_exit:-?}" "$p_task" "$RESET"
    done < <(printf '%s' "$precond_rows")

    # Worktree branches waiting on a human (merge, or orphaned changes). A
    # task in review/ is already listed above, so fix is not repeated here.
    for a in "${wt_attention[@]}"; do
        IFS=$'\t' read -r a_proj a_name a_why <<< "$a"
        printf '  %s⇢%s %-40s  %s[%s]%s  %s(%s, see WORKTREES)%s\n' \
            "$YELLOW" "$RESET" "$a_name" "$CYAN" "$a_proj" "$RESET" "$DIM" "$a_why" "$RESET"
    done

    # Routines that will not run, or have stopped running (see AGENTS).
    for a in "${ag_attention[@]}"; do
        IFS=$'\t' read -r a_slug a_agent a_why <<< "$a"
        printf '  %s⚠%s %-40s  %s[%s]%s  %s(%s, see AGENTS)%s\n' \
            "$YELLOW" "$RESET" "$a_slug" "$CYAN" "$a_agent" "$RESET" "$DIM" "$a_why" "$RESET"
    done
fi

# ── Pipeline ────────────────────────────────────────────────────
_section "  PIPELINE"

printf '  '
_stage "briefs" "$n_briefs"
printf ' → '
_stage "prep-review" "$n_brev" warn
printf ' → '
_stage "inbox" "$n_inbox"
printf ' → '
_stage "running" "$n_run"
printf ' → '
_stage "review" "$n_review" warn
# Not a pipeline stage: blocked tasks are inside inbox/ and already counted
# there. Rendered on the same line because that is where a reader is looking
# when they wonder why the inbox count is not going down.
if [ "$n_blocked" -gt 0 ]; then
    printf '   %s⊘ blocked(%d)%s' "${BOLD}${RED}" "$n_blocked" "$RESET"
fi
printf '\n'

# ── Running ─────────────────────────────────────────────────────
_section "  RUNNING"

running=()
while IFS= read -r name; do
    [ -n "$name" ] && running+=("$name")
done < <(_list "$RUN_DIR")

if [ ${#running[@]} -eq 0 ]; then
    printf '  %s(none)%s\n' "$DIM" "$RESET"
else
    for name in "${running[@]}"; do
        f="$RUN_DIR/${name}.md"
        [ -f "$f" ] || f=$(find "$RUN_DIR" -maxdepth 1 -type f -name "${name}.md" | head -1)
        elapsed=$(_elapsed "$f")

        # ai-task drops a .state sidecar recording the exact runner and
        # session it claimed the task under; that is ground truth. Fall back
        # to resolving the task's own ## Runner only when no sidecar exists
        # (e.g. a brief mid-decomposition, or an item claimed some other way).
        runner="" sess=""
        state="$RUN_DIR/${name}.state"
        if [ -f "$state" ]; then
            runner=$(awk -F= '/^runner=/{print $2; exit}' "$state")
            sess=$(awk -F= '/^session=/{print $2; exit}' "$state")
        fi
        [ -n "$runner" ] || runner=$(_runner_of "$f")

        if [ -n "$sess" ] && tmux has-session -t "=$sess" 2>/dev/null; then
            status="${GREEN}● live${RESET}"
        elif tmux has-session -t "=$(_session_brief "$runner" "$name")" 2>/dev/null; then
            status="${GREEN}● live${RESET}  ${DIM}brief${RESET}"
        elif tmux has-session -t "=$(_session_task "$runner" "$name")" 2>/dev/null; then
            status="${GREEN}● live${RESET}"
        else
            status="${YELLOW}○ orphan${RESET}"
        fi
        printf '  %b  %s[%s]%s  %-45s  %s(%s)%s\n' \
            "$status" "$CYAN" "$runner" "$RESET" "$name" "$DIM" "$elapsed" "$RESET"
    done
fi

# ── Worktrees (scanned above, before NEEDS ATTENTION) ────────────
# Most urgent first: what blocks work, then what waits on a human, then what
# resolves on its own.
if [ "${#wt_rows[@]}" -gt 0 ]; then
    _section "  WORKTREES"
    while IFS="$US" read -r _ wt_proj wt_name wt_icon wt_color wt_text; do
        printf '  %-*s  %-*s  %s%s %s%s\n' "$wt_w_proj" "$wt_proj" "$wt_w_name" "$wt_name" \
            "$wt_color" "$wt_icon" "$wt_text" "$RESET"
    done < <(printf '%s\n' "${wt_rows[@]}" | sort -s -t "$US" -k1,1n)
fi

# ── Today's stats ────────────────────────────────────────────────
_section "  TODAY  $(date '+%Y-%m-%d')"

fail_color=""
[ "$n_failed" -gt 0 ] && fail_color="$RED"
review_color=""
[ "$n_needs_review" -gt 0 ] && review_color="$RED"
defer_color=""
[ "$n_deferred" -gt 0 ] && defer_color="$CYAN"

printf '  %sCompleted:%s %s%d%s   %sRetried:%s %d   %sDeferred:%s %s%d%s   %sFailed:%s %s%d%s   %sNeeds Review:%s %s%d%s\n' \
    "$BOLD" "$RESET" "$GREEN" "$n_done" "$RESET" \
    "$BOLD" "$RESET" "$n_retry" \
    "$BOLD" "$RESET" "$defer_color" "$n_deferred" "$RESET" \
    "$BOLD" "$RESET" "$fail_color" "$n_failed" "$RESET" \
    "$BOLD" "$RESET" "$review_color" "$n_needs_review" "$RESET"

# ── By runner ─────────────────────────────────────────────────────
_section "  BY RUNNER"

declare -A runner_briefs runner_brev runner_inbox runner_run runner_review

_tally_runner() {
    local dir="$1"
    local -n _rmap="$2"
    local file r
    [ -d "$dir" ] || return
    while IFS= read -r name; do
        [ -z "$name" ] && continue
        file="$dir/${name}.md"
        [ -f "$file" ] || continue
        r=$(_runner_of "$file")
        _rmap[$r]=$(( ${_rmap[$r]:-0} + 1 ))
    done < <(_list "$dir")
}

_tally_runner "$BRIEFS_DIR"         runner_briefs
_tally_runner "$BACKLOG_REVIEW_DIR" runner_brev
_tally_runner "$INBOX"              runner_inbox
_tally_runner "$RUN_DIR"            runner_run
_tally_runner "$REVIEW_DIR"         runner_review

declare -A all_runners
for r in "${!runner_briefs[@]}" "${!runner_brev[@]}" \
         "${!runner_inbox[@]}" "${!runner_run[@]}" "${!runner_review[@]}"; do
    all_runners[$r]=1
done

if [ ${#all_runners[@]} -eq 0 ]; then
    printf '  %s(no tasks in pipeline)%s\n' "$DIM" "$RESET"
else
    for r in $(printf '%s\n' "${!all_runners[@]}" | sort); do
        printf '  %s%-20s%s' "$BOLD" "$r" "$RESET"
        [ "${runner_briefs[$r]:-0}" -gt 0 ] && printf '  briefs:%d'          "${runner_briefs[$r]}"
        [ "${runner_brev[$r]:-0}"   -gt 0 ] && printf '  %sprep-review:%d%s' "$YELLOW" "${runner_brev[$r]}" "$RESET"
        [ "${runner_inbox[$r]:-0}"  -gt 0 ] && printf '  inbox:%d'           "${runner_inbox[$r]}"
        [ "${runner_run[$r]:-0}"    -gt 0 ] && printf '  %srunning:%d%s'     "$GREEN" "${runner_run[$r]}" "$RESET"
        [ "${runner_review[$r]:-0}" -gt 0 ] && printf '  %sreview:%d%s'      "$RED" "${runner_review[$r]}" "$RESET"
        printf '\n'
    done
fi

# ── By project ───────────────────────────────────────────────────
_section "  BY PROJECT"

declare -A proj_briefs proj_brev proj_inbox proj_run proj_review

_tally() {
    local dir="$1"
    local -n _map="$2"
    local file proj
    [ -d "$dir" ] || return
    while IFS= read -r name; do
        [ -z "$name" ] && continue
        file="$dir/${name}.md"
        [ -f "$file" ] || continue
        proj=$(project_from_task "$file")
        [ -z "$proj" ] && proj="other"
        _map[$proj]=$(( ${_map[$proj]:-0} + 1 ))
    done < <(_list "$dir")
}

_tally "$BRIEFS_DIR"         proj_briefs
_tally "$BACKLOG_REVIEW_DIR" proj_brev
_tally "$INBOX"              proj_inbox
_tally "$RUN_DIR"            proj_run
_tally "$REVIEW_DIR"         proj_review

declare -A all_projects
for p in "${!proj_briefs[@]}" "${!proj_brev[@]}" \
         "${!proj_inbox[@]}" "${!proj_run[@]}" "${!proj_review[@]}"; do
    all_projects[$p]=1
done

if [ ${#all_projects[@]} -eq 0 ]; then
    printf '  %s(no tasks in pipeline)%s\n' "$DIM" "$RESET"
else
    for proj in $(printf '%s\n' "${!all_projects[@]}" | sort); do
        printf '  %s%-20s%s' "$BOLD" "$proj" "$RESET"
        [ "${proj_briefs[$proj]:-0}" -gt 0 ] && printf '  briefs:%d'          "${proj_briefs[$proj]}"
        [ "${proj_brev[$proj]:-0}"   -gt 0 ] && printf '  %sprep-review:%d%s' "$YELLOW" "${proj_brev[$proj]}" "$RESET"
        [ "${proj_inbox[$proj]:-0}"  -gt 0 ] && printf '  inbox:%d'           "${proj_inbox[$proj]}"
        [ "${proj_run[$proj]:-0}"    -gt 0 ] && printf '  %srunning:%d%s'     "$GREEN" "${proj_run[$proj]}" "$RESET"
        [ "${proj_review[$proj]:-0}" -gt 0 ] && printf '  %sreview:%d%s'      "$RED" "${proj_review[$proj]}" "$RESET"
        printf '\n'
    done
fi

# ── Recent activity ───────────────────────────────────────────────
_section "  RECENT ACTIVITY"

if [ -f "$LOG" ]; then
    awk '
        /^## [0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2} - / {
            split($0, h, " - ")
            ts = substr(h[1], 4)
            name = h[2]
            status = ""
            result = ""
        }
        /^\*\*Status:\*\*/ && name != "" {
            line = $0
            sub(/^\*\*Status:\*\* /, "", line)
            status = line
        }
        /^\*\*Result:\*\*/ && name != "" && status != "" {
            line = $0
            sub(/^\*\*Result:\*\* `/, "", line)
            sub(/`$/, "", line)
            entries[n++] = ts "|" name "|" status "|" line
            name = ""
        }
        END {
            start = (n > 8) ? n - 8 : 0
            for (i = start; i < n; i++) print entries[i]
        }
    ' "$LOG" | while IFS='|' read -r ts name status result; do
        time_part="${ts#* }"
        display=$(_display "$name")
        runner=$(_runner_of_result "$result")

        if [[ "$status" == *"completed"* ]];      then icon="${GREEN}✓${RESET}"
        elif [[ "$status" == *"requeued"* ]];     then icon="${YELLOW}↺${RESET}"
        elif [[ "$status" == *"DEFERRED"* ]];     then icon="${CYAN}↓${RESET}"
        elif [[ "$status" == *"NEEDS REVIEW"* ]]; then icon="${RED}!${RESET}"
        else                                           icon="${RED}✗${RESET}"
        fi

        printf '  %s  %b  %s[%s]%s  %s%-45s%s  %s%s%s\n' \
            "$time_part" "$icon" "$CYAN" "$runner" "$RESET" "$BOLD" "$display" "$RESET" "$DIM" "$status" "$RESET"
    done
else
    printf '  %s(no log yet)%s\n' "$DIM" "$RESET"
fi

# ── Agents (scanned above, before NEEDS ATTENTION) ───────────────
if [ "$ag_any" -eq 1 ]; then
    _section "  AGENTS"
    if [ "${#ag_rows[@]}" -gt 0 ]; then
        while IFS="$US" read -r _ ag_slug ag_agent ag_icon ag_color ag_text ag_stats; do
            printf '  %s%s%s %-*s  %s%-*s%s  %s%s%s' "$ag_color" "$ag_icon" "$RESET" \
                "$ag_w_slug" "$ag_slug" "$DIM" "$ag_w_agent" "$ag_agent" "$RESET" \
                "$ag_color" "$ag_text" "$RESET"
            [ -n "$ag_stats" ] && printf '  %s· %s%s' "$DIM" "$ag_stats" "$RESET"
            printf '\n'
        done < <(printf '%s\n' "${ag_rows[@]}" | sort -s -t "$US" -k1,1n)
    fi
    if [ "$ag_unpub" -gt 0 ]; then
        ag_s="s"; [ "$ag_unpub" -eq 1 ] && ag_s=""
        printf '  %s· %d routine%s defined, not published: ai-agent --publish-plan%s\n' \
            "$DIM" "$ag_unpub" "$ag_s" "$RESET"
    fi
fi

printf '\n%s%s%s\n' "$DIM" "$(date '+Updated: %H:%M:%S')  ·  live: dtask -w" "$RESET"
